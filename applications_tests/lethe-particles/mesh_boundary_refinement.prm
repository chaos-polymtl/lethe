# Description:
# Checks that the "boundaries refined" and "initial boundary refinement"
# parameters of the mesh subsection are applied in DEM simulations. They are
# declared in the shared Parameters::Mesh struct, but until the DEM and CFD mesh
# reading paths were unified they were silently ignored by lethe-particles.
#
# The domain is a cube uniformly refined twice, then refined once more in the
# vicinity of the two boundaries normal to x (ids 0 and 1). The reported minimum
# vertex distance therefore halves with respect to a uniformly refined mesh.

set dimension = 3

#---------------------------------------------------
# Simulation Control
#---------------------------------------------------

subsection simulation control
  set time step        = 1e-5
  set time end         = 1e-4
  set log frequency    = 1000000
  set output frequency = 0
end

#---------------------------------------------------
# Timer
#---------------------------------------------------

subsection timer
  set type = none
end

#---------------------------------------------------
# Test
#---------------------------------------------------

subsection test
  set enable = true
end

#---------------------------------------------------
# Model Parameters
#---------------------------------------------------

subsection model parameters
  subsection contact detection
    set contact detection method                = dynamic
    set dynamic contact search size coefficient = 0.9
    set neighborhood threshold                  = 1.3
  end
  set particle particle contact force method = hertz_mindlin_limit_overlap
  set particle wall contact force method     = nonlinear
  set rolling resistance torque method       = none
  set integration method                     = velocity_verlet
end

#---------------------------------------------------
# Lagrangian Physical Properties
#---------------------------------------------------

subsection lagrangian physical properties
  set g                        = 0.0, 0.0, -9.81
  set number of particle types = 1
  subsection particle type 0
    set size distribution type            = uniform
    set diameter                          = 0.005
    set number of particles               = 10
    set density particles                 = 1000
    set young modulus particles           = 1000000
    set poisson ratio particles           = 0.3
    set restitution coefficient particles = 0.3
    set friction coefficient particles    = 0.1
  end
  set young modulus wall           = 1000000
  set poisson ratio wall           = 0.3
  set restitution coefficient wall = 0.3
  set friction coefficient wall    = 0.1
end

#---------------------------------------------------
# Insertion Info
#---------------------------------------------------

subsection insertion info
  set insertion method                               = volume
  set inserted number of particles at each time step = 10
  set insertion frequency                            = 2000000
  set insertion box points coordinates               = -0.03, -0.03, -0.03 : 0.03, 0.03, -0.01
  set insertion distance threshold                   = 1.5
  set insertion maximum offset                       = 0.2
  set insertion prn seed                             = 19
end

#---------------------------------------------------
# Mesh
#---------------------------------------------------

subsection mesh
  set type                        = dealii
  set grid type                   = hyper_cube
  set grid arguments              = -0.04 : 0.04 : true
  set initial refinement          = 2
  set boundaries refined          = 0, 1
  set initial boundary refinement = 1
end
