# Test description: Verify the `packed` insertion method with a solid surface. A total of 200 particles are inserted into a tight insertion box inside a hyper_cube. A square solid surface made of triangles crosses the middle of the insertion box. Since the particles initially overlap each other and the solid surface, the insertion algorithm shifts them apart iteratively until they no longer overlap. The solid surface has a translational velocity, which must be ignored: the solid surface does not move during the packed insertion. The packed overlap factors and clearance ratio differ from their default values to verify that they are used.

# Listing of Parameters
#----------------------

set dimension = 3

#---------------------------------------------------
# Simulation Control
#---------------------------------------------------

subsection simulation control
  set time step        = 1e-5
  set time end         = 0.1
  set log frequency    = 10
  set output frequency = 0
end

#---------------------------------------------------
# Timer
#---------------------------------------------------

subsection timer
  set type = none
end

#---------------------------------------------------
# Test
#---------------------------------------------------

subsection test
  set enable = true
end

#---------------------------------------------------
# Model Parameters
#---------------------------------------------------

subsection model parameters
  subsection contact detection
    set contact detection method                = dynamic
    set dynamic contact search size coefficient = 0.9
    set neighborhood threshold                  = 1.3
  end
  set particle particle contact force method = hertz_mindlin_limit_overlap
  set particle wall contact force method     = nonlinear
  set rolling resistance torque method       = none
  set integration method                     = velocity_verlet
end

#---------------------------------------------------
# Lagrangian Physical Properties
#---------------------------------------------------

subsection lagrangian physical properties
  set g                        = 0.0, 0.0, -9.81
  set number of particle types = 1
  subsection particle type 0
    set size distribution type            = uniform
    set diameter                          = 0.005
    set number of particles               = 200
    set density particles                 = 1000
    set young modulus particles           = 1000000
    set poisson ratio particles           = 0.3
    set restitution coefficient particles = 0.3
    set friction coefficient particles    = 0.1
  end
  set young modulus wall           = 1000000
  set poisson ratio wall           = 0.3
  set restitution coefficient wall = 0.3
  set friction coefficient wall    = 0.1
end

#---------------------------------------------------
# Insertion Info
#---------------------------------------------------

subsection insertion info
  set insertion method                               = packed
  set inserted number of particles at each time step = 200
  set insertion frequency                            = 2000000
  set insertion box points coordinates               = -0.01, -0.01, -0.01 : 0.01, 0.01, 0.01
  set insertion distance threshold                   = 1.5
  set insertion maximum offset                       = 0.2
  set insertion prn seed                             = 19
  set packed particle-particle overlap factor        = 0.51
  set packed particle-wall overlap factor            = 1.05
  set packed clearance ratio                         = 0.02
end

#---------------------------------------------------
# Mesh
#---------------------------------------------------

subsection mesh
  set type                                = dealii
  set grid type                           = hyper_cube
  set grid arguments                      = -0.04 : 0.04 : false
  set initial refinement                  = 3
  set expand particle-wall contact search = false
end

#---------------------------------------------------
# Solid Objects
#---------------------------------------------------

subsection solid objects
  subsection solid surfaces
    set number of solids = 1
    subsection solid object 0
      subsection mesh
        set type               = dealii
        set grid type          = hyper_cube
        set grid arguments     = -0.04 : 0.04 : false
        set simplex            = true
        set initial refinement = 2
      end
      subsection translational velocity
        set Function expression = 0 ; 0 ; 10
      end
    end
  end
end
