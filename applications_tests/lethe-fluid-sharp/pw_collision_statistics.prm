# Bounce of a soft particle on a wall that does not contain the origin, with
# the particle-wall collision statistics. The contact lasts several time steps,
# so both the start and the end of the collision are logged. The fluid has no
# density, so it does not act on the particle.

# Listing of Parameters
#----------------------

set dimension = 2

#---------------------------------------------------
# Simulation Control
#---------------------------------------------------

subsection simulation control
  set method           = bdf1
  set time step        = 0.0025
  set time end         = 0.02
  set output frequency = 0
  set log precision    = 4
end

#---------------------------------------------------
# Physical Properties
#---------------------------------------------------

subsection physical properties
  subsection fluid 0
    set kinematic viscosity = 0.604166666666667
    set density             = 0
  end
end

#---------------------------------------------------
# Timer
#---------------------------------------------------

subsection timer
  set type = none
end

#---------------------------------------------------
# FEM
#---------------------------------------------------

subsection FEM
  set velocity degree = 1
  set pressure degree = 1
end

#---------------------------------------------------
# Mesh
#---------------------------------------------------

subsection mesh
  set type               = dealii
  set grid type          = subdivided_hyper_rectangle
  set grid arguments     = 4,4: 0,1 : 4,5 : true
  set initial refinement = 1
end

#---------------------------------------------------
# Boundary Conditions
#---------------------------------------------------

subsection boundary conditions
  set number = 4
  subsection bc 0
    set id   = 0
    set type = noslip
  end
  subsection bc 1
    set id   = 1
    set type = noslip
  end
  subsection bc 2
    set id   = 2
    set type = noslip
  end
  subsection bc 3
    set id   = 3
    set type = outlet
    set beta = 0
  end
end

#---------------------------------------------------
# DEM Post-processing
#---------------------------------------------------

subsection post-processing
  subsection particle wall collision statistics
    set enable particle wall collision statistics = true
    set verbosity                                 = verbose
    set log collisions with all walls             = true
  end
end

#---------------------------------------------------
# IB Particles
#---------------------------------------------------

subsection particles
  set number of particles                     = 1
  set assemble Navier-Stokes inside particles = false

  subsection extrapolation function
    set stencil degree = 6
  end

  subsection local mesh refinement
    set initial refinement                = 2
    set refine mesh inside radius factor  = 0.5
    set refine mesh outside radius factor = 1.5
  end

  subsection DEM
    set enable lubrication force = false
    subsection gravity
      set Function expression = 0;0
    end
    subsection wall physical properties
      set wall youngs modulus          = 3000000
      set wall restitution coefficient = 0.9
    end
  end

  subsection particle info 0
    set integrate motion = true
    subsection position
      set Function expression = 2;1.501
    end
    subsection velocity
      set Function expression = 0;-1
    end
    subsection omega
      set Function expression = 0;0;0
    end
    set pressure location = 0.00001; 0.00001
    set type              = sphere
    set shape arguments   = 0.5

    subsection physical properties
      set density                 = 1
      set youngs modulus          = 3000000
      set restitution coefficient = 0.9
    end
  end
end

#---------------------------------------------------
# Mesh Adaptation Control
#---------------------------------------------------

subsection mesh adaptation
  set fraction coarsening  = 0.4
  set fraction refinement  = 0.05
  set fraction type        = number
  set frequency            = 1
  set max number elements  = 75000
  set max refinement level = 3
  set min refinement level = 0
  set type                 = adaptive
  set error estimator      = kelly
  set variable             = velocity
end

#---------------------------------------------------
# Initial Conditions
#---------------------------------------------------

subsection initial conditions
  set type = nodal
end

#---------------------------------------------------
# Non-Linear Solver Control
#---------------------------------------------------

subsection non-linear solver
  subsection fluid dynamics
    set tolerance             = 1e-8
    set max iterations        = 5
    set verbosity             = quiet
    set force rhs calculation = true
  end
end

#---------------------------------------------------
# Forces
#---------------------------------------------------

subsection forces
  set calculate force = false
  set verbosity       = quiet
end

#---------------------------------------------------
# Linear Solver Control
#---------------------------------------------------

subsection linear solver
  subsection fluid dynamics
    set method                                = gmres
    set max iters                             = 1000
    set relative residual                     = 1e-4
    set minimum residual                      = 1e-11
    set preconditioner                        = ilu
    set ilu preconditioner fill               = 0
    set ilu preconditioner absolute tolerance = 1e-20
    set ilu preconditioner relative tolerance = 1.00
    set verbosity                             = quiet
    set max krylov vectors                    = 1000
  end
end
