# Steady diffusion of a tracer around a disk of radius R = 0.25 whose surface
# consumes the tracer with a first-order reaction, imposed with the
# sharp-interface immersed boundary method (robin type). The flux into the
# disk is alpha c + q, with alpha = 1 and q = 2. With a unit diffusivity, the
# exact solution is c = 2 + ln(r/R), where r is the distance to the center of
# the disk. It is also imposed on the boundary of the domain. The fluid is at
# rest.

set dimension = 2

#---------------------------------------------------
# Simulation Control
#---------------------------------------------------

subsection simulation control
  set method            = steady
  set number mesh adapt = 2
  set output frequency  = 0
end

#---------------------------------------------------
# Multiphysics
#---------------------------------------------------

subsection multiphysics
  set fluid dynamics = true
  set tracer         = true
end

#---------------------------------------------------
# FEM
#---------------------------------------------------

subsection FEM
  set velocity degree = 1
  set pressure degree = 1
  set tracer degree   = 1
end

#---------------------------------------------------
# Mesh
#---------------------------------------------------

subsection mesh
  set type               = dealii
  set grid type          = subdivided_hyper_rectangle
  set grid arguments     = 1, 1 : -1, -1 : 1, 1 : false
  set initial refinement = 4
end

#---------------------------------------------------
# Mesh Adaptation Control
#---------------------------------------------------

subsection mesh adaptation
  set type = uniform
end

#---------------------------------------------------
# Physical Properties
#---------------------------------------------------

subsection physical properties
  set number of fluids = 1
  subsection fluid 0
    set tracer diffusivity = 1
  end
end

#---------------------------------------------------
# Boundary Conditions
#---------------------------------------------------

subsection boundary conditions
  set number = 1
  subsection bc 0
    set id   = 0
    set type = noslip
  end
end

#---------------------------------------------------
# Boundary Conditions Tracer
#---------------------------------------------------

subsection boundary conditions tracer
  set number = 1
  subsection bc 0
    set id   = 0
    set type = dirichlet
    subsection dirichlet
      set Function constants  = xc=0.0123, yc=-0.0071, R=0.25
      set Function expression = 2 + log(sqrt((x-xc)^2+(y-yc)^2)/R)
    end
  end
end

#---------------------------------------------------
# IB Particles
#---------------------------------------------------

subsection particles
  set number of particles = 1
  subsection output
    set calculate force = false
  end
  subsection tracer boundary condition
    set type              = robin
    set reaction constant = 1
    set reaction order    = 1
    subsection flux
      set Function expression = 2
    end
  end
  subsection particle info 0
    set type            = sphere
    set shape arguments = 0.25
    subsection position
      set Function expression = 0.0123; -0.0071
    end
  end
end

#---------------------------------------------------
# Analytical Solution
#---------------------------------------------------

subsection analytical solution
  set enable    = true
  set verbosity = verbose
  subsection tracer
    set Function constants  = xc=0.0123, yc=-0.0071, R=0.25
    set Function expression = 2 + log(sqrt((x-xc)^2+(y-yc)^2)/R)
  end
end

#---------------------------------------------------
# Non-Linear Solver Control
#---------------------------------------------------

subsection non-linear solver
  subsection fluid dynamics
    set verbosity = quiet
    set tolerance = 1e-8
  end
  subsection tracer
    set verbosity      = quiet
    set tolerance      = 1e-10
    set max iterations = 5
  end
end

#---------------------------------------------------
# Linear Solver Control
#---------------------------------------------------

subsection linear solver
  subsection fluid dynamics
    set verbosity = quiet
  end
  subsection tracer
    set verbosity         = quiet
    set relative residual = 1e-10
    set minimum residual  = 1e-14
  end
end
