# Transient diffusion of a tracer towards a moving disk whose surface consumes
# the tracer instantly (c = 0), imposed with the sharp-interface immersed
# boundary method. The disk moves with a prescribed velocity through a fluid
# at rest. The test checks that the immersed boundary constraints follow the
# disk, through the tracer statistics.

set dimension = 2

#---------------------------------------------------
# Simulation Control
#---------------------------------------------------

subsection simulation control
  set method           = bdf2
  set time step        = 0.01
  set time end         = 0.05
  set output frequency = 0
end

#---------------------------------------------------
# Multiphysics
#---------------------------------------------------

subsection multiphysics
  set fluid dynamics = false
  set tracer         = true
end

#---------------------------------------------------
# FEM
#---------------------------------------------------

subsection FEM
  set velocity degree = 1
  set pressure degree = 1
  set tracer degree   = 1
end

#---------------------------------------------------
# Mesh
#---------------------------------------------------

subsection mesh
  set type               = dealii
  set grid type          = subdivided_hyper_rectangle
  set grid arguments     = 1, 1 : -1, -1 : 1, 1 : false
  set initial refinement = 5
end

#---------------------------------------------------
# Initial Conditions
#---------------------------------------------------

subsection initial conditions
  set type = nodal
  subsection uvwp
    set Function expression = 0; 0; 0
  end
  subsection tracer
    set Function expression = 1
  end
end

#---------------------------------------------------
# Physical Properties
#---------------------------------------------------

subsection physical properties
  set number of fluids = 1
  subsection fluid 0
    set tracer diffusivity = 0.01
  end
end

#---------------------------------------------------
# Boundary Conditions Tracer
#---------------------------------------------------

subsection boundary conditions tracer
  set number = 1
  subsection bc 0
    set id   = 0
    set type = dirichlet
    subsection dirichlet
      set Function expression = 1
    end
  end
end

#---------------------------------------------------
# Post-Processing
#---------------------------------------------------

subsection post-processing
  set verbosity                   = verbose
  set calculate tracer statistics = true
  set tracer statistics name      = tracer_statistics
end

#---------------------------------------------------
# IB Particles
#---------------------------------------------------

subsection particles
  set number of particles = 1
  subsection output
    set calculate force = false
    set print DEM       = false
  end
  subsection tracer boundary condition
    set type = dirichlet
    subsection dirichlet
      set Function expression = 0
    end
  end
  subsection particle info 0
    set type            = sphere
    set shape arguments = 0.15
    subsection position
      set Function expression = -0.2 + 2*t; 0.0071
    end
    subsection velocity
      set Function expression = 2; 0
    end
  end
end

#---------------------------------------------------
# Non-Linear Solver Control
#---------------------------------------------------

subsection non-linear solver
  subsection tracer
    set verbosity      = quiet
    set tolerance      = 1e-10
    set max iterations = 5
  end
end

#---------------------------------------------------
# Linear Solver Control
#---------------------------------------------------

subsection linear solver
  subsection tracer
    set verbosity         = quiet
    set relative residual = 1e-10
    set minimum residual  = 1e-14
  end
end
