# BDF3 motion: history spans more than half a period before the first wrap.

set dimension = 2

subsection simulation control
  set method            = bdf3
  set time step         = 0.6
  set number mesh adapt = 3
  set time end          = 2.4
  set output name       = test
  set output frequency  = 0
  set log precision     = 4
end

subsection physical properties
  subsection fluid 0
    set kinematic viscosity = 0.1
  end
end

subsection mesh
  set type               = dealii
  set grid type          = subdivided_hyper_rectangle
  set grid arguments     = 1,1:-1,-1 : 1,1 : true
  set initial refinement = 3
end

subsection FEM
  set velocity degree = 1
  set pressure degree = 1
end

subsection boundary conditions
  set fix pressure constant = true
  set number                = 3
  subsection bc 0
    set id                 = 0
    set type               = periodic
    set periodic id        = 1
    set periodic direction = 0
  end
  subsection bc 1
    set id   = 2
    set type = noslip
  end
  subsection bc 2
    set id   = 3
    set type = noslip
  end
end

subsection particles
  set number of particles                     = 1
  set assemble Navier-Stokes inside particles = true
  subsection output
    set print DEM = true
  end
  subsection extrapolation function
    set stencil degree = 1
    set length ratio   = 1.1
  end
  subsection input file
    set load particles from file = false
    set particles file           = particles.input
  end
  subsection local mesh refinement
    set initial refinement                = 1
    set refine mesh inside radius factor  = 0
    set refine mesh outside radius factor = 2
  end
  subsection DEM
    set alpha = 0.5
    subsection gravity
      set Function expression = 0;0
    end
  end
  subsection particle info 0
    subsection position
      set Function expression = -0.9;0
    end
    subsection velocity
      set Function expression = 1;0
    end
    subsection omega
      set Function expression = 0;0;0
    end
    set pressure location = 0.00001; 0.00001
    set type              = sphere
    set shape arguments   = 0.15
    set integrate motion  = true
    subsection physical properties
      set density = 1000000
      set inertia = 1
    end
  end
end

subsection mesh adaptation
  set fraction coarsening  = 0
  set fraction refinement  = 0
  set fraction type        = number
  set frequency            = 1
  set max number elements  = 40000
  set min refinement level = 0
  set max refinement level = 5
  set type                 = none
  set error estimator      = kelly
  set variable             = velocity
end

subsection non-linear solver
  subsection fluid dynamics
    set tolerance             = 1e-7
    set max iterations        = 20
    set verbosity             = quiet
    set step tolerance        = 0.99
    set force rhs calculation = true
  end
end

subsection forces
  set verbosity = verbose
end

subsection initial conditions
  set type                = nodal
  set kinematic viscosity = 0.005
end

subsection linear solver
  subsection fluid dynamics
    set method                                = gmres
    set max krylov vectors                    = 250
    set max iters                             = 1000
    set relative residual                     = 1e-6
    set minimum residual                      = 1e-11
    set preconditioner                        = ilu
    set ilu preconditioner fill               = 1
    set ilu preconditioner absolute tolerance = 1e-11
    set ilu preconditioner relative tolerance = 1
    set verbosity                             = quiet
  end
end

subsection DEM boundary conditions
  set number of boundary conditions = 1
  subsection boundary condition 0
    set type               = periodic
    set periodic id 0      = 0
    set periodic id 1      = 1
    set periodic direction = 0
  end
end
