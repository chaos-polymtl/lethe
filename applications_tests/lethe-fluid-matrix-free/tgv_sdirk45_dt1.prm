# Temporal convergence of SDIRK45 (4th order) on the Taylor-Green vortex with
# the matrix-free solver. This test (dt = 0.5) and `tgv_sdirk45_dt2`
# (dt = 0.25) are identical except for the time step. The Q3-Q3 spatial error
# is negligible, so halving dt should divide the velocity L2 error at t=1 by
# 2^4 = 16. Observed: 1.091902e-03 (dt1) and 6.546289e-05 (dt2), a ratio of
# 16.7, i.e. an order of 4.06.

# Listing of Parameters
#----------------------

set dimension = 2

#---------------------------------------------------
# Simulation Control
#---------------------------------------------------

subsection simulation control
  set method            = sdirk45
  set time step         = 0.5
  set number mesh adapt = 0
  set time end          = 1.0
  set output name       = tgv
  set output frequency  = 0
end

#---------------------------------------------------
# FEM
#---------------------------------------------------

subsection FEM
  set velocity degree = 3
  set pressure degree = 3
end

#---------------------------------------------------
# Timer
#---------------------------------------------------

subsection timer
  set type = none # <none|iteration|end>
end

#---------------------------------------------------
# Initial Conditions
#---------------------------------------------------

subsection initial conditions
  set type = nodal
  subsection uvwp
    set Function expression = cos(x)*sin(y); -sin(x)*cos(y); -1./4*(cos(2*x)+cos(2*y));
  end
end

#---------------------------------------------------
# Physical Properties
#---------------------------------------------------

subsection physical properties
  set number of fluids = 1
  subsection fluid 0
    set kinematic viscosity = 1.00
  end
end

#---------------------------------------------------
# Analytical Solution
#---------------------------------------------------

subsection analytical solution
  set verbosity = verbose
  set enable    = true
  subsection uvwp
    set Function constants  = viscosity=1
    set Function expression = exp(-2*viscosity*t)*   cos(x) * sin(y) ; -sin(x) * cos(y) * exp(-2*viscosity*t); 0
  end
end

#---------------------------------------------------
# Post-Processing
#---------------------------------------------------

subsection post-processing
  set verbosity                = verbose
  set calculate enstrophy      = true
  set calculate kinetic energy = true
end

#---------------------------------------------------
# Mesh
#---------------------------------------------------

subsection mesh
  set type               = dealii
  set grid type          = hyper_cube
  set grid arguments     = 0 : 6.28318530718 : true
  set initial refinement = 4 # initial mesh refinement
end

#---------------------------------------------------
# Mesh Adaptation Control
#---------------------------------------------------

subsection mesh adaptation
  set type = none
end

#---------------------------------------------------
# Boundary Conditions
#---------------------------------------------------

subsection boundary conditions
  set number                = 2
  set fix pressure constant = true
  subsection bc 0
    set type               = periodic
    set id                 = 0
    set periodic id        = 1
    set periodic direction = 0
  end
  subsection bc 1
    set type               = periodic
    set id                 = 2
    set periodic id        = 3
    set periodic direction = 1
  end
end

#---------------------------------------------------
# Source Term
#---------------------------------------------------

subsection source term
  subsection fluid dynamics
    set enable = false
  end
end

#---------------------------------------------------
# Non-Linear Solver Control
#---------------------------------------------------

subsection non-linear solver
  subsection fluid dynamics
    set verbosity = quiet
    # Tight tolerance since the SDIRK45 coefficients amplify stage errors
    set tolerance = 1e-10
  end
end

#---------------------------------------------------
# Linear Solver Control
#---------------------------------------------------

subsection linear solver
  subsection fluid dynamics
    set method            = gmres
    set max iters         = 100
    set relative residual = 1e-4
    set minimum residual  = 1e-11
    set preconditioner    = gcmg
    set verbosity         = quiet

    # MG parameters
    set mg verbosity                   = quiet
    set mg enable hessians in jacobian = false

    # Smoother
    set mg smoother iterations          = 2
    set mg smoother eig estimation      = true
    set mg smoother preconditioner type = additive_schwarz_method

    # Eigenvalue estimation parameters
    set eig estimation smoothing range = 5
    set eig estimation cg n iterations = 20
    set eig estimation verbosity       = quiet

    #coarse-grid solver
    set mg coarse grid solver = direct
  end
end
