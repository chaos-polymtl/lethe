# Temporal manufactured solution for the SDIRK33 scheme with the matrix-free
# solver. The velocity u = (sin(4t), 0) is spatially uniform in a periodic box
# and is driven by the time-dependent source term f = (4 cos(4t), 0). The
# spatial discretization is exact, so the L2 error is the temporal error of the
# scheme alone. It is third-order only if the source term is evaluated at the
# time of each stage.
# The matrix-free operator precomputes the source term, which must therefore
# be recomputed at every stage.

# Listing of Parameters
#----------------------

set dimension = 2

#---------------------------------------------------
# Simulation Control
#---------------------------------------------------

subsection simulation control
  set method           = sdirk33
  set time step        = 0.1
  set time end         = 1.0
  set output name      = mms-temporal-forcing
  set output frequency = 0
end

#---------------------------------------------------
# FEM
#---------------------------------------------------

subsection FEM
  set velocity degree = 1
  set pressure degree = 1
end

#---------------------------------------------------
# Timer
#---------------------------------------------------

subsection timer
  set type = none
end

#---------------------------------------------------
# Initial Conditions
#---------------------------------------------------

subsection initial conditions
  set type = nodal
  subsection uvwp
    set Function expression = 0; 0; 0
  end
end

#---------------------------------------------------
# Physical Properties
#---------------------------------------------------

subsection physical properties
  set number of fluids = 1
  subsection fluid 0
    set kinematic viscosity = 1.0
  end
end

#---------------------------------------------------
# Source Term
#---------------------------------------------------

subsection source term
  subsection fluid dynamics
    set enable              = true
    set Function expression = 4*cos(4*t); 0; 0
  end
end

#---------------------------------------------------
# Analytical Solution
#---------------------------------------------------

subsection analytical solution
  set verbosity = verbose
  set enable    = true
  subsection uvwp
    set Function expression = sin(4*t); 0; 0
  end
end

#---------------------------------------------------
# Mesh
#---------------------------------------------------

subsection mesh
  set type               = dealii
  set grid type          = hyper_cube
  set grid arguments     = 0 : 6.28318530718 : true
  set initial refinement = 2
end

#---------------------------------------------------
# Boundary Conditions
#---------------------------------------------------

subsection boundary conditions
  set number                = 2
  set fix pressure constant = true
  subsection bc 0
    set type               = periodic
    set id                 = 0
    set periodic id        = 1
    set periodic direction = 0
  end
  subsection bc 1
    set type               = periodic
    set id                 = 2
    set periodic id        = 3
    set periodic direction = 1
  end
end

#---------------------------------------------------
# Non-Linear Solver Control
#---------------------------------------------------

subsection non-linear solver
  subsection fluid dynamics
    set verbosity      = quiet
    set tolerance      = 1e-10
    set max iterations = 10
  end
end

#---------------------------------------------------
# Linear Solver Control
#---------------------------------------------------

subsection linear solver
  subsection fluid dynamics
    set method            = gmres
    set max iters         = 5000
    set relative residual = 1e-12
    set minimum residual  = 1e-13
    set preconditioner    = gcmg
    set verbosity         = quiet

    # MG parameters
    set mg verbosity       = quiet
    set mg min level       = -1
    set mg level min cells = 16

    # Smoother
    set mg smoother iterations     = 10
    set mg smoother eig estimation = true

    # Eigenvalue estimation parameters
    set eig estimation smoothing range = 5
    set eig estimation cg n iterations = 20
    set eig estimation verbosity       = quiet

    # Coarse-grid solver
    set mg coarse grid solver = direct
  end
end
