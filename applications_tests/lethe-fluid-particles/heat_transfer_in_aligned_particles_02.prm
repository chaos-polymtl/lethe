# Listing of Parameters
#----------------------

# This test is the CFD-DEM counterpart of the wall-heating case of the
# 3d-heat-transfer-in-aligned-particles example of the dem-mp folder, with the
# same setup as the heat_transfer_in_aligned_particles test. Ten aligned
# particles at 0 C are held in compression between two isothermal walls and
# exchange heat by conduction with them and between themselves.
#
# The CFD-DEM solver does not support solid objects, so the two isothermal
# plates of the DEM case are replaced by the two walls of the grid normal to
# the x axis, placed where the plates come to rest (x = +-0.049). As in the
# DEM case, the left wall stays at 0 C and the right wall is switched from 0 C
# to 50 C. Since the chain is inserted already compressed, the switch occurs at
# t = 0.3 instead of t = 8. This is in the middle of the second CFD time step,
# which verifies that the temperature of the walls is updated at every DEM
# iteration.
#
# It verifies the isothermal DEM boundary conditions within the CFD-DEM solver.
# The fluid dynamics is disabled and every fluid-particle interaction force is
# turned off, so the particles obey the same equations as they would in the
# pure DEM solver.

set dimension = 3

#---------------------------------------------------
# Simulation Control
#---------------------------------------------------

# The DEM time step is the CFD time step divided by the coupling frequency,
# which gives 5e-5 s. The coupling frequency is large so that the conduction
# has the time to be established while the particle summary is only printed a
# few times.

subsection simulation control
  set method           = bdf1
  set time step        = 0.25
  set time end         = 1
  set output frequency = 0
end

#---------------------------------------------------
# Multiphysics
#---------------------------------------------------

subsection multiphysics
  set fluid dynamics = false
end

#---------------------------------------------------
# Timer
#---------------------------------------------------

subsection timer
  set type = none
end

#---------------------------------------------------
# Test
#---------------------------------------------------

subsection test
  set enable = true
end

#---------------------------------------------------
# FEM
#---------------------------------------------------

subsection FEM
  set velocity degree = 1
  set pressure degree = 1
end

#---------------------------------------------------
# Initial Conditions
#---------------------------------------------------

subsection initial conditions
  set type = nodal
  subsection uvwp
    set Function expression = 0; 0; 0; 0
  end
end

#---------------------------------------------------
# Physical Properties
#---------------------------------------------------

# The fluid is never solved and never acts on the particles. These values are
# only there because the solver requires a fluid to be defined.

subsection physical properties
  subsection fluid 0
    set kinematic viscosity = 1.5e-5
    set density             = 1.2
  end
end

#---------------------------------------------------
# Mesh
#---------------------------------------------------

# The boundaries are colorized: boundary 0 is the wall at x = -0.049 and
# boundary 1 is the wall at x = 0.049. They replace the plates of the DEM case.

subsection mesh
  set type               = dealii
  set grid type          = hyper_rectangle
  set grid arguments     = -0.049 , -0.025 , -0.025 : 0.049 , 0.025 , 0.025 : true
  set initial refinement = 1
end

#---------------------------------------------------
# Void Fraction
#---------------------------------------------------

subsection void fraction
  set mode = function
  subsection function
    set Function expression = 1
  end
end

#---------------------------------------------------
# CFD-DEM
#---------------------------------------------------

subsection cfd-dem
  set drag force          = false
  set buoyancy force      = false
  set shear force         = false
  set pressure force      = false
  set coupling frequency  = 5000
  set particle statistics = false
end

#---------------------------------------------------
# Boundary Conditions
#---------------------------------------------------

subsection boundary conditions
  set number = 6
  subsection bc 0
    set id   = 0,1,2,3,4,5
    set type = slip
  end
end

#---------------------------------------------------
# DEM Boundary Conditions
#---------------------------------------------------

# The two walls which hold the chain of particles are isothermal, like the two
# plates of the DEM case. The other walls are not touched by the particles.

subsection DEM boundary conditions
  set number of boundary conditions = 2
  subsection boundary condition 0
    set boundary id           = 0
    set type                  = fixed_wall
    set thermal boundary type = isothermal
    subsection wall temperature
      set Function expression = 0
    end
  end
  subsection boundary condition 1
    set boundary id           = 1
    set type                  = fixed_wall
    set thermal boundary type = isothermal
    subsection wall temperature
      set Function expression = if(t > 0.3, 50, 0)
    end
  end
end

#---------------------------------------------------
# Model parameters
#---------------------------------------------------

subsection model parameters
  subsection contact detection
    set contact detection method                = dynamic
    set dynamic contact search size coefficient = 0.9
    set neighborhood threshold                  = 1.3
  end
  set particle particle contact force method = hertz_mindlin_limit_overlap
  set rolling resistance torque method       = constant
  set particle wall contact force method     = nonlinear
  set integration method                     = velocity_verlet
  set solver type                            = dem_mp
end

#---------------------------------------------------
# Lagrangian Physical Properties
#---------------------------------------------------

subsection lagrangian physical properties
  set g                        = 0.0, 0.0, 0.0
  set number of particle types = 1
  subsection particle type 0
    set size distribution type            = uniform
    set diameter                          = 0.01
    set number of particles               = 10
    set density particles                 = 2500
    set young modulus particles           = 1e6
    set poisson ratio particles           = 0.3
    set restitution coefficient particles = 0.3
    set friction coefficient particles    = 0.3
    set rolling friction particles        = 0.3
    set thermal conductivity particles    = 3000
    set specific heat particles           = 300
    set microhardness particles           = 1.e9
    set surface slope particles           = 0.1
    set surface roughness particles       = 1.e-9
    set thermal accommodation particles   = 0.7
  end
  set young modulus wall           = 1e6
  set poisson ratio wall           = 0.3
  set restitution coefficient wall = 0.3
  set friction coefficient wall    = 0.3
  set rolling friction wall        = 0.3
  set thermal conductivity wall    = 100
  set microhardness wall           = 1.e9
  set surface slope wall           = 0.1
  set surface roughness wall       = 1.e-10
  set thermal accommodation wall   = 0.7
  set thermal conductivity gas     = 0.2
  set specific heat gas            = 10000
  set dynamic viscosity gas        = 9.e-6
  set specific heats ratio gas     = 1.4
  set molecular mean free path gas = 68.e-9
end

#---------------------------------------------------
# Insertion Info
#---------------------------------------------------

subsection insertion info
  set insertion method    = file
  set insertion frequency = 10000
  set list of input files = particles-wall-heating.input
end

#---------------------------------------------------
# Linear Solver Control
#---------------------------------------------------

subsection linear solver
  subsection void fraction
    set relative residual = 1e-15
    set minimum residual  = 1e-15
    set verbosity         = quiet
  end
end
