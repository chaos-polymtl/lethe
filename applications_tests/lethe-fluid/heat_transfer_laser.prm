#-------------------------------------------------------------------------------
# DESCRIPTION:
# This test checks exponential decay laser model by simulating the laser
# following a track along the x-axis.
# The global enthalpy variation post-processing is also checked here.
# From the enthalpy variation of the first time we can approximate the net
# power added to the system with P = \frac{\Delta H}{\alpha \Delta t} f_\mathrm{2D}
# where f_\mathrm{2D} = \sqrt{\frac{\pi R^2}{\eta}} is the factor taking into
# account the 2D approximation of the 3D source. We get approximately P = 101 W,
# very little difference is observed with the inputted power.
#-------------------------------------------------------------------------------

# Listing of Parameters
#----------------------

set dimension = 2

#---------------------------------------------------
# Simulation Control
#---------------------------------------------------

subsection simulation control
  set method                         = bdf1
  set time end                       = 0.05
  set time step                      = 0.005
  set adapt time step to respect CFL = false
  set number mesh adapt              = 0
  set output name                    = laser
  set output frequency               = 0
  set subdivision                    = 1
end

#---------------------------------------------------
# Multiphysics
#---------------------------------------------------

subsection multiphysics
  set heat transfer = true
end

#---------------------------------------------------
# Laser Parameters
#---------------------------------------------------

subsection laser parameters
  set enable               = true
  set type                 = exponential_decay
  set concentration factor = 2
  set power                = 100
  set absorptivity         = 0.6
  set penetration depth    = 0.01
  set beam radius          = 0.002
  set start time           = 0
  set end time             = 0.05
  set beam orientation     = y-
  subsection path
    set Function expression = 2 * t; 0.1
  end
end

#---------------------------------------------------
# Post-Processing
#---------------------------------------------------

subsection post-processing
  set verbosity                           = verbose
  set calculate temperature statistics    = true
  set calculate global enthalpy variation = true
end

#---------------------------------------------------
# Initial Conditions
#---------------------------------------------------

subsection initial conditions
  set type = nodal
end

#---------------------------------------------------
# Physical Properties
#---------------------------------------------------

subsection physical properties
  set number of fluids = 1
  subsection fluid 0
    set density             = 1000
    set kinematic viscosity = 0.01
  end
end

#---------------------------------------------------
# Mesh
#---------------------------------------------------

subsection mesh
  set type               = dealii
  set grid type          = subdivided_hyper_rectangle
  set grid arguments     = 1, 1: 0, 0 : 0.1, 0.1 : false
  set initial refinement = 5
end

#---------------------------------------------------
# Boundary Conditions
#---------------------------------------------------

subsection boundary conditions
  set number = 1
  subsection bc 0
    set id   = 0
    set type = noslip
  end
end

#---------------------------------------------------
# Boundary Conditions Heat Transfer
#---------------------------------------------------

subsection boundary conditions heat transfer
  set number = 1
  subsection bc 0
    set id   = 0
    set type = convection-radiation-flux
    subsection h
      set Function expression = 10
    end
    subsection Tinf
      set Function expression = 20
    end
    subsection emissivity
      set Function expression = 0.5
    end
  end
end

#---------------------------------------------------
# FEM
#---------------------------------------------------

subsection FEM
  set velocity degree = 1
  set pressure degree = 1
end

#---------------------------------------------------
# Non-Linear Solver Control
#---------------------------------------------------

subsection non-linear solver
  subsection heat transfer
    set tolerance      = 1e-8
    set max iterations = 100
    set verbosity      = quiet
  end
  subsection fluid dynamics
    set tolerance      = 1e-8
    set max iterations = 100
    set verbosity      = quiet
  end
end

#---------------------------------------------------
# Linear Solver Control
#---------------------------------------------------

subsection linear solver
  subsection fluid dynamics
    set verbosity                             = quiet
    set method                                = gmres
    set relative residual                     = 1e-3
    set minimum residual                      = 1e-8
    set preconditioner                        = ilu
    set ilu preconditioner fill               = 0
    set ilu preconditioner absolute tolerance = 1e-12
    set ilu preconditioner relative tolerance = 1.00
    set max krylov vectors                    = 200
  end
  subsection heat transfer
    set verbosity                             = quiet
    set method                                = gmres
    set relative residual                     = 1e-3
    set minimum residual                      = 1e-8
    set preconditioner                        = ilu
    set ilu preconditioner fill               = 0
    set ilu preconditioner absolute tolerance = 1e-12
    set ilu preconditioner relative tolerance = 1.00
    set max krylov vectors                    = 200
  end
end
