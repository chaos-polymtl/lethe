# Listing of Parameters
#----------------------

# Nucleation in a fluid at rest, without particles at the beginning. The
# nuclei are created at the rate J = 1e19 exp(20 t) per m^3 per s, given with
# the function model, with a log-normal distribution of mean size 1e-8 m and
# standard deviation 3e-9 m. The particles therefore follow this log-normal
# distribution, with the number density 1e19 (exp(20 t) - 1) / 20. The first
# step creates the particles without quadrature, and the following ones invert
# their moments.

set dimension = 2

#---------------------------------------------------
# Simulation Control
#---------------------------------------------------

subsection simulation control
  set method           = bdf1
  set time end         = 0.05
  set time step        = 0.005
  set output frequency = 0
end

#---------------------------------------------------
# FEM
#---------------------------------------------------

subsection FEM
  set velocity degree = 1
  set pressure degree = 1
  set qmom degree     = 1
end

#---------------------------------------------------
# QMOM
#---------------------------------------------------

subsection QMOM
  set number of moments = 4
  set enable nucleation = true
  subsection nucleation
    set model                     = function
    set Function expression       = 1e19 * exp(20 * t)
    set nuclei mean size          = 1e-8
    set nuclei standard deviation = 3e-9
  end
end

#---------------------------------------------------
# Initial Conditions
#---------------------------------------------------

subsection initial conditions
  set type = nodal
  subsection uvwp
    set Function expression = 0; 0; 0
  end
  subsection QMOM
    subsection distribution
      set type = none
    end
  end
end

#---------------------------------------------------
# Physical Properties
#---------------------------------------------------

subsection physical properties
  set number of fluids = 1
end

#---------------------------------------------------
# Mesh
#---------------------------------------------------

subsection mesh
  set type               = dealii
  set grid type          = subdivided_hyper_rectangle
  set grid arguments     = 20, 1 : 0, 0 : 1, 0.05 : true
  set initial refinement = 0
end

#---------------------------------------------------
# Multiphysics
#---------------------------------------------------

subsection multiphysics
  set qmom = true
end

#---------------------------------------------------
# Analytical Solution
#---------------------------------------------------

subsection analytical solution
  set enable    = true
  set verbosity = verbose
  subsection uvwp
    set Function expression = 0; 0; 0
  end
  subsection QMOM
    subsection distribution
      set type                = lognormal
      set Function expression = 1e19 * (exp(20 * t) - 1) / 20; log(1e-8) - 0.5 * log(1.09); sqrt(log(1.09))
    end
  end
end

#---------------------------------------------------
# Boundary Conditions
#---------------------------------------------------

subsection boundary conditions
  set number = 4
  subsection bc 0
    set id   = 0
    set type = noslip
  end
  subsection bc 1
    set id   = 1
    set type = noslip
  end
  subsection bc 2
    set id   = 2
    set type = noslip
  end
  subsection bc 3
    set id   = 3
    set type = noslip
  end
end

#---------------------------------------------------
# Boundary Conditions QMOM
#---------------------------------------------------

subsection boundary conditions qmom
  set number = 1
  subsection bc 0
    set id   = 0, 1, 2, 3
    set type = noflux
  end
end

#---------------------------------------------------
# Non-Linear Solver Control
#---------------------------------------------------

subsection non-linear solver
  subsection fluid dynamics
    set verbosity      = quiet
    set tolerance      = 1e-9
    set max iterations = 1
  end
end

#---------------------------------------------------
# Linear Solver Control
#---------------------------------------------------

subsection linear solver
  subsection fluid dynamics
    set verbosity                             = quiet
    set method                                = gmres
    set max iters                             = 100
    set relative residual                     = 1e-13
    set minimum residual                      = 1e-14
    set preconditioner                        = ilu
    set ilu preconditioner fill               = 0
    set ilu preconditioner absolute tolerance = 1e-14
    set ilu preconditioner relative tolerance = 1.00
  end
  subsection qmom
    set verbosity                             = quiet
    set method                                = gmres
    set max iters                             = 100
    set max krylov vectors                    = 100
    set relative residual                     = 1e-12
    set minimum residual                      = 1e-30
    set preconditioner                        = ilu
    set ilu preconditioner fill               = 0
    set ilu preconditioner absolute tolerance = 1e-14
    set ilu preconditioner relative tolerance = 1.00
  end
end
