# This test checks the boundary conditions of the DG formulation of the CLS.
# A pulse of the phase indicator, initially centered on the inlet, is advected
# by a uniform velocity field. The second half of the pulse enters the domain
# through a time-dependent dirichlet boundary condition and the whole pulse
# leaves the domain through a none boundary condition. The velocity field is
# imposed, hence, the fluid dynamics is not solved, only the CLS.

# Listing of Parameters
#----------------------

set dimension = 2

#---------------------------------------------------
# Simulation Control
#---------------------------------------------------

subsection simulation control
  set method           = bdf1
  set time end         = 1
  set time step        = 0.01
  set output frequency = 0
end

#---------------------------------------------------
# Multiphysics
#---------------------------------------------------

subsection multiphysics
  set fluid dynamics = false
  set cls            = true
end

#---------------------------------------------------
# FEM
#---------------------------------------------------

subsection FEM
  set velocity degree = 1
  set pressure degree = 1
  set cls degree      = 1
  set cls uses dg     = true
end

#---------------------------------------------------
# Initial Conditions
#---------------------------------------------------

subsection initial conditions
  set type = nodal
  subsection uvwp
    set Function expression = 1; 0; 0
  end
  subsection CLS
    set Function expression = 0.5+0.5*tanh(5-40*x^2)
  end
end

#---------------------------------------------------
# Physical Properties
#---------------------------------------------------

subsection physical properties
  set number of fluids = 2
  subsection fluid 0
    set density = 1
  end
  subsection fluid 1
    set density = 1
  end
end

#---------------------------------------------------
# Mesh
#---------------------------------------------------

subsection mesh
  set type               = dealii
  set grid type          = subdivided_hyper_rectangle
  set grid arguments     = 50, 1 : 0, 0 : 0.5, 0.01 : true
  set initial refinement = 0
end

#---------------------------------------------------
# Analytical Solution
#---------------------------------------------------

subsection analytical solution
  set enable    = true
  set verbosity = verbose
  subsection uvwp
    set Function expression = 1 ; 0 ; 0
  end
  subsection CLS
    set Function expression = 0.5+0.5*tanh(5-40*(x-t)^2)
  end
end

#---------------------------------------------------
# Boundary Conditions
#---------------------------------------------------

subsection boundary conditions
  set number = 4
  subsection bc 0
    set id   = 0
    set type = function
    subsection u
      set Function expression = 1
    end
    subsection v
      set Function expression = 0
    end
  end
  subsection bc 1
    set id   = 1
    set type = function
    subsection u
      set Function expression = 1
    end
    subsection v
      set Function expression = 0
    end
  end
  subsection bc 2
    set id   = 2
    set type = slip
  end
  subsection bc 3
    set id   = 3
    set type = slip
  end
end

#---------------------------------------------------
# Boundary Conditions CLS
#---------------------------------------------------

subsection boundary conditions CLS
  set number         = 4
  set time dependent = true
  subsection bc 0
    set id   = 0
    set type = dirichlet
    subsection dirichlet
      set Function expression = 0.5+0.5*tanh(5-40*(x-t)^2)
    end
  end
  subsection bc 1
    set id   = 1
    set type = none
  end
  subsection bc 2
    set id   = 2
    set type = none
  end
  subsection bc 3
    set id   = 3
    set type = none
  end
end

#---------------------------------------------------
# Non-Linear Solver Control
#---------------------------------------------------

subsection non-linear solver
  subsection CLS
    set verbosity      = quiet
    set tolerance      = 1e-9
    set max iterations = 1
  end
  subsection fluid dynamics
    set verbosity      = quiet
    set tolerance      = 1e-9
    set max iterations = 1
  end
end

#---------------------------------------------------
# Linear Solver Control
#---------------------------------------------------

subsection linear solver
  subsection fluid dynamics
    set verbosity                             = quiet
    set method                                = gmres
    set max iters                             = 100
    set relative residual                     = 1e-13
    set minimum residual                      = 1e-14
    set preconditioner                        = ilu
    set ilu preconditioner fill               = 0
    set ilu preconditioner absolute tolerance = 1e-14
    set ilu preconditioner relative tolerance = 1.00
  end
  subsection CLS
    set verbosity                             = quiet
    set method                                = gmres
    set max iters                             = 300
    set max krylov vectors                    = 300
    set relative residual                     = 1e-9
    set minimum residual                      = 1e-9
    set preconditioner                        = ilu
    set ilu preconditioner fill               = 0
    set ilu preconditioner absolute tolerance = 1e-14
    set ilu preconditioner relative tolerance = 1.00
  end
end
