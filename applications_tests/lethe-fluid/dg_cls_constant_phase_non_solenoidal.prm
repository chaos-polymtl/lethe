# This test checks that the DG formulation of the CLS preserves a uniform phase
# indicator when it is advected by a velocity field that is not
# divergence-free and that varies in time. The velocity field is imposed and it
# vanishes on all the boundaries, hence, the fluid dynamics is not solved, only
# the CLS. The phase indicator must remain equal to 1 everywhere. This requires
# that the advective form of the CLS equation is solved and that the cells and
# the faces are assembled with the same velocity, which is extrapolated in
# time with the BDF2 scheme.

# Listing of Parameters
#----------------------

set dimension = 2

#---------------------------------------------------
# Simulation Control
#---------------------------------------------------

subsection simulation control
  set method           = bdf2
  set time end         = 0.5
  set time step        = 0.05
  set output frequency = 0
end

#---------------------------------------------------
# Multiphysics
#---------------------------------------------------

subsection multiphysics
  set fluid dynamics = false
  set cls            = true
end

#---------------------------------------------------
# FEM
#---------------------------------------------------

subsection FEM
  set velocity degree = 1
  set pressure degree = 1
  set cls degree      = 1
  set cls uses dg     = true
end

#---------------------------------------------------
# Initial Conditions
#---------------------------------------------------

subsection initial conditions
  set type = nodal
  subsection uvwp
    set Function expression = (1+t)*sin(pi*x)*sin(pi*y); 0; 0
  end
  subsection CLS
    set Function expression = 1
  end
end

#---------------------------------------------------
# Physical Properties
#---------------------------------------------------

subsection physical properties
  set number of fluids = 2
  subsection fluid 0
    set density = 1
  end
  subsection fluid 1
    set density = 1
  end
end

#---------------------------------------------------
# Mesh
#---------------------------------------------------

subsection mesh
  set type               = dealii
  set grid type          = hyper_cube
  set grid arguments     = 0 : 1 : true
  set initial refinement = 3
end

#---------------------------------------------------
# Analytical Solution
#---------------------------------------------------

subsection analytical solution
  set enable    = true
  set verbosity = verbose
  subsection uvwp
    set Function expression = (1+t)*sin(pi*x)*sin(pi*y); 0; 0
  end
  subsection CLS
    set Function expression = 1
  end
end

#---------------------------------------------------
# Boundary Conditions
#---------------------------------------------------

subsection boundary conditions
  set number = 4
  subsection bc 0
    set id   = 0
    set type = noslip
  end
  subsection bc 1
    set id   = 1
    set type = noslip
  end
  subsection bc 2
    set id   = 2
    set type = noslip
  end
  subsection bc 3
    set id   = 3
    set type = noslip
  end
end

#---------------------------------------------------
# Boundary Conditions CLS
#---------------------------------------------------

subsection boundary conditions CLS
  set number = 4
  subsection bc 0
    set id   = 0
    set type = none
  end
  subsection bc 1
    set id   = 1
    set type = none
  end
  subsection bc 2
    set id   = 2
    set type = none
  end
  subsection bc 3
    set id   = 3
    set type = none
  end
end

#---------------------------------------------------
# Non-Linear Solver Control
#---------------------------------------------------

subsection non-linear solver
  subsection CLS
    set verbosity      = quiet
    set tolerance      = 1e-9
    set max iterations = 1
  end
  subsection fluid dynamics
    set verbosity      = quiet
    set tolerance      = 1e-9
    set max iterations = 1
  end
end

#---------------------------------------------------
# Linear Solver Control
#---------------------------------------------------

subsection linear solver
  subsection fluid dynamics
    set verbosity                             = quiet
    set method                                = gmres
    set max iters                             = 100
    set relative residual                     = 1e-13
    set minimum residual                      = 1e-14
    set preconditioner                        = ilu
    set ilu preconditioner fill               = 0
    set ilu preconditioner absolute tolerance = 1e-14
    set ilu preconditioner relative tolerance = 1.00
  end
  subsection CLS
    set verbosity                             = quiet
    set method                                = gmres
    set max iters                             = 300
    set max krylov vectors                    = 300
    set relative residual                     = 1e-9
    set minimum residual                      = 1e-9
    set preconditioner                        = ilu
    set ilu preconditioner fill               = 0
    set ilu preconditioner absolute tolerance = 1e-14
    set ilu preconditioner relative tolerance = 1.00
  end
end
