# Test description: This test solves the 2D Taylor-Green vortex of
# rbvms_transient_bdf3_dynamic on two processes with the BDF2 time-stepping
# scheme and a mesh that is adapted every two time steps with the Kelly error
# estimator. The history of the fine-scale velocity of the dynamic velocity
# subscale, stored at the quadrature points, is interpolated to the children
# of the refined cells and projected to the parent of the coarsened cells. The
# L2 error on the velocity, the kinetic energy and the enstrophy are monitored
# at every time step.

# Listing of Parameters
#----------------------

set dimension = 2

#---------------------------------------------------
# Simulation Control
#---------------------------------------------------

subsection simulation control
  set method            = bdf2
  set time step         = 0.1
  set number mesh adapt = 0
  set time end          = 0.5
  set output name       = tgv
  set output frequency  = 0
end

#---------------------------------------------------
# Stabilization
#---------------------------------------------------

subsection stabilization
  set use default stabilization = false
  set stabilization             = rbvms
  set velocity subscale         = dynamic
end

#---------------------------------------------------
# FEM
#---------------------------------------------------

subsection FEM
  set velocity degree = 2
  set pressure degree = 2
end

#---------------------------------------------------
# Timer
#---------------------------------------------------

subsection timer
  set type = none
end

#---------------------------------------------------
# Initial condition
#---------------------------------------------------

subsection initial conditions
  set type = nodal
  subsection uvwp
    set Function expression = cos(x)*sin(y); -sin(x)*cos(y); -1./4*(cos(2*x)+cos(2*y));
  end
end

#---------------------------------------------------
# Physical Properties
#---------------------------------------------------

subsection physical properties
  set number of fluids = 1
  subsection fluid 0
    set kinematic viscosity = 0.01
  end
end

#---------------------------------------------------
# Analytical Solution
#---------------------------------------------------

subsection analytical solution
  set verbosity = verbose
  set enable    = true
  subsection uvwp
    set Function constants  = viscosity=0.01
    set Function expression = exp(-2*viscosity*t)*cos(x)*sin(y); -sin(x)*cos(y)*exp(-2*viscosity*t); 0
  end
end

#---------------------------------------------------
# Post-processing
#---------------------------------------------------

subsection post-processing
  set verbosity                = verbose
  set calculate enstrophy      = true
  set calculate kinetic energy = true
end

#---------------------------------------------------
# Mesh
#---------------------------------------------------

subsection mesh
  set type               = dealii
  set grid type          = hyper_cube
  set grid arguments     = 0 : 6.28318530718 : true
  set initial refinement = 3
end

#---------------------------------------------------
# Mesh Adaptation
#---------------------------------------------------

subsection mesh adaptation
  set type                 = adaptive
  set error estimator      = kelly
  set variable             = velocity
  set fraction type        = number
  set max number elements  = 5000
  set max refinement level = 4
  set min refinement level = 2
  set frequency            = 2
  set fraction refinement  = 0.3
  set fraction coarsening  = 0.2
end

#---------------------------------------------------
# Boundary Conditions
#---------------------------------------------------

subsection boundary conditions
  set number = 2
  subsection bc 0
    set type               = periodic
    set id                 = 0
    set periodic id        = 1
    set periodic direction = 0
  end
  subsection bc 1
    set type               = periodic
    set id                 = 2
    set periodic id        = 3
    set periodic direction = 1
  end
end

#---------------------------------------------------
# Source Term
#---------------------------------------------------

subsection source term
  subsection fluid dynamics
    set enable = false
  end
end

#---------------------------------------------------
# Non-Linear Solver Control
#---------------------------------------------------

subsection non-linear solver
  subsection fluid dynamics
    set verbosity      = quiet
    set tolerance      = 1e-8
    set max iterations = 10
  end
end

#---------------------------------------------------
# Linear Solver Control
#---------------------------------------------------

subsection linear solver
  subsection fluid dynamics
    set verbosity                             = quiet
    set method                                = gmres
    set max iters                             = 5000
    set relative residual                     = 1e-4
    set minimum residual                      = 1e-10
    set preconditioner                        = ilu
    set ilu preconditioner fill               = 1
    set ilu preconditioner absolute tolerance = 1e-10
    set ilu preconditioner relative tolerance = 1.00
  end
end
