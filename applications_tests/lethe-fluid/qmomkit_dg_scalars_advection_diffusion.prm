# Listing of Parameters
#----------------------

# Advection-diffusion of a scalar by a uniform velocity u = 1, with the
# steady manufactured solution c = 1 + 0.5 sin(pi x) and the diffusivity
# D = 0.1 of the QMOM subsection. The source term balances the advection and
# the diffusion: S = u dc/dx - D d2c/dx2. The values are imposed by Dirichlet
# boundary conditions at the inlet and at the outlet, which tests the Nitsche
# method on both the inflow and the outflow. The second scalar does not
# diffuse and is advected without deformation, and the moments of a uniform
# log-normal particle size distribution are constant, so that they are
# unchanged by the diffusion of the first scalar.

set dimension = 2

#---------------------------------------------------
# Simulation Control
#---------------------------------------------------

subsection simulation control
  set method           = bdf2
  set time end         = 0.05
  set time step        = 0.005
  set output frequency = 0
end

#---------------------------------------------------
# FEM
#---------------------------------------------------

subsection FEM
  set velocity degree = 1
  set pressure degree = 1
  set qmom degree     = 1
end

#---------------------------------------------------
# QMOM
#---------------------------------------------------

subsection QMOM
  set number of scalars    = 2
  set scalar names         = diffused_scalar, advected_scalar
  set scalar diffusivities = 0.1, 0
  set number of moments    = 2
end

#---------------------------------------------------
# Initial Conditions
#---------------------------------------------------

subsection initial conditions
  set type = nodal
  subsection uvwp
    set Function expression = 1; 0; 0
  end
  subsection QMOM
    subsection scalars
      set Function expression = 1 + 0.5 * sin(pi * x); 1 + 0.5 * sin(2 * pi * x)
    end
    subsection distribution
      set type                = lognormal
      set Function expression = 1e18; log(1e-7); 0.3
    end
  end
end

#---------------------------------------------------
# Source Term
#---------------------------------------------------

subsection source term
  subsection QMOM
    subsection scalars
      set Function expression = 0.5 * pi * cos(pi * x) + 0.05 * pi * pi * sin(pi * x); 0
    end
  end
end

#---------------------------------------------------
# Physical Properties
#---------------------------------------------------

subsection physical properties
  set number of fluids = 1
end

#---------------------------------------------------
# Mesh
#---------------------------------------------------

subsection mesh
  set type               = dealii
  set grid type          = subdivided_hyper_rectangle
  set grid arguments     = 20, 1 : 0, 0 : 1, 0.05 : true
  set initial refinement = 0
end

#---------------------------------------------------
# Multiphysics
#---------------------------------------------------

subsection multiphysics
  set qmom = true
end

#---------------------------------------------------
# Analytical Solution
#---------------------------------------------------

subsection analytical solution
  set enable    = true
  set verbosity = verbose
  subsection uvwp
    set Function expression = 1; 0; 0
  end
  subsection QMOM
    subsection scalars
      set Function expression = 1 + 0.5 * sin(pi * x); 1 + 0.5 * sin(2 * pi * (x - t))
    end
    subsection distribution
      set type                = lognormal
      set Function expression = 1e18; log(1e-7); 0.3
    end
  end
end

#---------------------------------------------------
# Boundary Conditions
#---------------------------------------------------

subsection boundary conditions
  set number = 3
  subsection bc 0
    set id   = 0
    set type = function
    subsection u
      set Function expression = 1
    end
  end
  subsection bc 1
    set id   = 2, 3
    set type = slip
  end
  subsection bc 2
    set id   = 1
    set type = outlet
    set beta = 0
  end
end

#---------------------------------------------------
# Boundary Conditions QMOM
#---------------------------------------------------

subsection boundary conditions qmom
  set number         = 2
  set time dependent = true
  subsection bc 0
    set id   = 0, 1
    set type = dirichlet
    subsection dirichlet
      subsection scalars
        set Function expression = 1 + 0.5 * sin(pi * x); 1 + 0.5 * sin(2 * pi * (x - t))
      end
      subsection distribution
        set type                = lognormal
        set Function expression = 1e18; log(1e-7); 0.3
      end
    end
  end
  subsection bc 1
    set id   = 2, 3
    set type = noflux
  end
end

#---------------------------------------------------
# Non-Linear Solver Control
#---------------------------------------------------

subsection non-linear solver
  subsection fluid dynamics
    set verbosity      = quiet
    set tolerance      = 1e-9
    set max iterations = 1
  end
end

#---------------------------------------------------
# Linear Solver Control
#---------------------------------------------------

subsection linear solver
  subsection fluid dynamics
    set verbosity                             = quiet
    set method                                = gmres
    set max iters                             = 100
    set relative residual                     = 1e-13
    set minimum residual                      = 1e-14
    set preconditioner                        = ilu
    set ilu preconditioner fill               = 0
    set ilu preconditioner absolute tolerance = 1e-14
    set ilu preconditioner relative tolerance = 1.00
  end
  subsection qmom
    set verbosity                             = quiet
    set method                                = gmres
    set max iters                             = 100
    set max krylov vectors                    = 100
    set relative residual                     = 1e-12
    set minimum residual                      = 1e-30
    set preconditioner                        = ilu
    set ilu preconditioner fill               = 0
    set ilu preconditioner absolute tolerance = 1e-14
    set ilu preconditioner relative tolerance = 1.00
  end
end
