# This test verifies that the pressure boundary condition imposes the normal
# traction -p_bc n, using the matrix-based solver. The exact solution is the 2D
# stagnation flow u = x, v = -y, p = -(x^2+y^2)/2, which solves the steady
# Navier-Stokes equations for any viscosity without source term. The velocity
# is imposed on x = 0 and y = 0 (boundaries 0 and 2), and pressure boundary
# conditions are applied on x = 1 and y = 1 (boundaries 1 and 3). There, the
# normal viscous stress is +nu and -nu respectively, so the exact solution is
# recovered with p_bc = p - nu on x = 1 and p_bc = p + nu on y = 1. Since the
# Q2Q2 element pair can represent the analytical solution exactly, the L2 error
# should be limited only by the tolerance of the solvers.

# Listing of Parameters
#----------------------

set dimension = 2

#---------------------------------------------------
# Simulation Control
#---------------------------------------------------

subsection simulation control
  set method           = steady
  set output frequency = 0
end

#---------------------------------------------------
# FEM
#---------------------------------------------------

subsection FEM
  set velocity degree = 2
  set pressure degree = 2
end

#---------------------------------------------------
# Physical Properties
#---------------------------------------------------

subsection physical properties
  set number of fluids = 1
  subsection fluid 0
    set kinematic viscosity = 1.000
  end
end

#---------------------------------------------------
# Analytical Solution
#---------------------------------------------------

subsection analytical solution
  set enable = true
  subsection uvwp
    set Function expression = x ; -y ; -(x*x + y*y)/2
  end
end

#---------------------------------------------------
# Mesh
#---------------------------------------------------

subsection mesh
  set type               = dealii
  set grid type          = hyper_cube
  set grid arguments     = 0 : 1 : true
  set initial refinement = 3
end

#---------------------------------------------------
# Boundary Conditions
#---------------------------------------------------

subsection boundary conditions
  set number = 3
  subsection bc 0
    set type = function
    set id   = 0, 2
    subsection u
      set Function expression = x
    end
    subsection v
      set Function expression = -y
    end
  end
  subsection bc 1
    set type = pressure
    set id   = 1
    subsection p
      set Function constants  = nu=1
      set Function expression = -(x*x + y*y)/2 - nu
    end
  end
  subsection bc 2
    set type = pressure
    set id   = 3
    subsection p
      set Function constants  = nu=1
      set Function expression = -(x*x + y*y)/2 + nu
    end
  end
end

#---------------------------------------------------
# Non-Linear Solver Control
#---------------------------------------------------

subsection non-linear solver
  subsection fluid dynamics
    set verbosity = quiet
    set tolerance = 1e-10
  end
end

#---------------------------------------------------
# Linear Solver Control
#---------------------------------------------------

subsection linear solver
  subsection fluid dynamics
    set verbosity                             = quiet
    set method                                = gmres
    set max iters                             = 5000
    set relative residual                     = 1e-6
    set minimum residual                      = 1e-13
    set preconditioner                        = ilu
    set ilu preconditioner fill               = 1
    set ilu preconditioner absolute tolerance = 1e-5
    set ilu preconditioner relative tolerance = 1.00
  end
end
