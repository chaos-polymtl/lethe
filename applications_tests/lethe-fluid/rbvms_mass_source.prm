# Test description: Q2 exactly represents u=(x^2,0), p=0 with viscosity 1,
# mass source 2*x and momentum force (4*x^3-2,0). Starting at this solution
# must give zero residual and errors up to round-off. This checks that RBVMS
# grad-div stabilization uses div(u)-mass_source instead of div(u).

# Listing of Parameters
#----------------------

set dimension = 2

#---------------------------------------------------
# Simulation Control
#---------------------------------------------------

subsection simulation control
  set method            = steady
  set number mesh adapt = 0
  set output name       = mms2d_
  set output frequency  = 0
end

#---------------------------------------------------
# Stabilization
#---------------------------------------------------

subsection stabilization
  set use default stabilization = false
  set stabilization             = rbvms
end

#---------------------------------------------------
# FEM
#---------------------------------------------------

subsection FEM
  set velocity degree = 2
  set pressure degree = 2
end

#---------------------------------------------------
# Physical Properties
#---------------------------------------------------

subsection physical properties
  set number of fluids = 1
  subsection fluid 0
    set kinematic viscosity = 1.000
  end
end

#---------------------------------------------------
# Mesh
#---------------------------------------------------

subsection mesh
  set type               = dealii
  set grid type          = hyper_cube
  set grid arguments     = 0 : 1 : false
  set initial refinement = 2
end

#---------------------------------------------------
# Boundary Conditions
#---------------------------------------------------

subsection boundary conditions
  set number = 1
  subsection bc 0
    set id   = 0
    set type = function
    subsection u
      set Function expression = x*x
    end
    subsection v
      set Function expression = 0
    end
  end
end

#---------------------------------------------------
# Source Term
#---------------------------------------------------

subsection source term
  subsection fluid dynamics
    set Function expression = 4*x*x*x-2; 0; 2*x
  end
end

#---------------------------------------------------
# Analytical Solution
#---------------------------------------------------

subsection analytical solution
  set enable = true
  subsection uvwp
    set Function expression = x*x; 0; 0
  end
end

#---------------------------------------------------
# Mesh Adaptation Control
#---------------------------------------------------

subsection mesh adaptation
  set type = none
end

#---------------------------------------------------
# Non-Linear Solver Control
#---------------------------------------------------

subsection non-linear solver
  subsection fluid dynamics
    set tolerance      = 1e-12
    set max iterations = 30
    set verbosity      = verbose
  end
end

#---------------------------------------------------
# Linear Solver Control
#---------------------------------------------------

subsection linear solver
  subsection fluid dynamics
    set method            = gmres
    set max iters         = 5000
    set relative residual = 1e-4
    set minimum residual  = 1e-9
    set verbosity         = quiet
    set preconditioner    = ilu
  end
end

subsection initial conditions
  set type = nodal
  subsection uvwp
    set Function expression = x*x; 0; 0
  end
end

subsection timer
  set type = none
end
