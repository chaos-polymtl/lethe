# This test is a version of the "time_harmonic_maxwell_waveguide_robin_dissipative"
# test case of lethe-fluid, adapted so the dissipative medium is the mixture of
# a fluid and of an unresolved dispersed phase, solved with the "lethe-fluid-vans"
# solver. It solves the time-harmonic Maxwell equations for the TE12 mode of a
# waveguide with perfectly conducting walls, a waveguide port excitation at the
# inlet and an absorbing impedance boundary at the outlet.
#
# It verifies the effective medium properties of the time-harmonic Maxwell
# solver. The fluid dynamics is disabled and the void fraction is set to 0.6
# everywhere. Both phases are dissipative, with a non-zero conductivity. The
# properties of the dispersed phase were obtained by inverting the Bruggeman
# equation, such that the effective properties of the mixture are those of the
# dissipative medium of the lethe-fluid test:
#   effective electric permittivity : 1 + (0.01 + 0.07) i = 1 + 0.08 i
#   effective magnetic permeability : 1 + 0.02 i
# The L2 errors with respect to the analytical solution must therefore match
# those of the lethe-fluid time_harmonic_maxwell_waveguide_robin_dissipative test.

set dimension = 3

#---------------------------------------------------
# Simulation Control
#---------------------------------------------------

subsection simulation control
  set method            = steady
  set output frequency  = 0
  set number mesh adapt = 1
end

#---------------------------------------------------
# Mesh Adaptation Control
#---------------------------------------------------

subsection mesh adaptation
  set type = uniform
end

#---------------------------------------------------
# Multiphysics
#---------------------------------------------------

subsection multiphysics
  set fluid dynamics   = false
  set electromagnetics = true
end

#---------------------------------------------------
# Initial Conditions
#---------------------------------------------------

subsection initial conditions
  set type = nodal
  subsection uvwp
    set Function expression = 0; 0; 0; 0
  end
end

#---------------------------------------------------
# FEM
#---------------------------------------------------

subsection FEM
  set velocity degree = 1
  set pressure degree = 1

  set electromagnetics trial degree = 1
  set electromagnetics test degree  = 2
end

#---------------------------------------------------
# Physical Properties
#---------------------------------------------------

subsection physical properties
  set number of fluids = 1
  subsection fluid 0
    set electric conductivity model = constant
    set electric conductivity       = 0.02

    set electric permittivity model     = constant
    set electric permittivity real part = 1.
    set electric permittivity imag part = 0.01

    set magnetic permeability model     = constant
    set magnetic permeability real part = 1.
    set magnetic permeability imag part = 0.01
  end

  set number of unresolved dispersed phases = 1
  subsection unresolved dispersed phase 0
    set electric conductivity model = constant
    set electric conductivity       = 0.1

    set electric permittivity model     = constant
    set electric permittivity real part = 0.99687958527608012
    set electric permittivity imag part = 0.055119615897750246

    set magnetic permeability model     = constant
    set magnetic permeability real part = 0.99987501701157344
    set magnetic permeability imag part = 0.035001458134864979
  end

  set number of material interactions = 1
  subsection material interaction 0
    set type = fluid_dispersed_phase
    subsection fluid-dispersed phase interaction
      set fluid id           = 0
      set dispersed phase id = 0

      set electric permittivity effective medium model = bruggeman
      set magnetic permeability effective medium model = bruggeman
    end
  end
end

#---------------------------------------------------
# Mesh
#---------------------------------------------------

subsection mesh
  set type           = dealii
  set grid type      = subdivided_hyper_rectangle
  set grid arguments = 1, 2, 1 : 1, 1, 1 : 1.25, 1.5, 1.25 : true
end

#---------------------------------------------------
# Dimensionality
#---------------------------------------------------

subsection dimensionality
  set length = 0.01
end

#---------------------------------------------------
# Void Fraction
#---------------------------------------------------

subsection void fraction
  set mode = function
  subsection function
    set Function expression = 0.6
  end
end

#---------------------------------------------------
# CFD-DEM
#---------------------------------------------------

subsection cfd-dem
  set drag force     = false
  set buoyancy force = false
  set shear force    = false
  set pressure force = false
end

#---------------------------------------------------
# Time Harmonic Maxwell
#---------------------------------------------------

subsection time harmonic maxwell
  set electromagnetic frequency  = 8.99377374e10
  set number of waveguide inlets = 1

  subsection waveguide inlet 0
    set port boundary id = 4

    set corner 0 = 1,1,1
    set corner 1 = 1.25,1,1
    set corner 2 = 1, 1.5, 1
    set corner 3 = 1.25, 1.5, 1

    subsection waveguide mode
      set mode type    = TE
      set mode order m = 1
      set mode order n = 2
    end
  end
end

#---------------------------------------------------
# Boundary Conditions
#---------------------------------------------------

subsection boundary conditions
  set number = 1
  subsection bc 0
    set id   = 0, 1, 2, 3, 4, 5
    set type = noslip
  end
end

#---------------------------------------------------
# Boundary Conditions Time Harmonic Maxwell
#---------------------------------------------------

subsection boundary conditions time harmonic maxwell
  set number = 3
  subsection bc 0
    set id   = 0, 1, 2, 3
    set type = pec
  end
  subsection bc 1
    set id   = 4
    set type = waveguide_port
  end
  subsection bc 2
    set id   = 5
    set type = impedance_boundary
    subsection excitation x real part
      set Function expression = 0
    end
    subsection excitation x imag part
      set Function expression = 0
    end
    subsection excitation y real part
      set Function expression = 0
    end
    subsection excitation y imag part
      set Function expression = 0
    end
    subsection excitation z real part
      set Function expression = 0
    end
    subsection excitation z imag part
      set Function expression = 0
    end
    subsection surface admittance real part
      set Function expression = 0.360746
    end
    subsection surface admittance imag part
      set Function expression = 0.132856
    end
  end
end

#---------------------------------------------------
# Analytical Solution
#---------------------------------------------------

subsection analytical solution
  set enable    = true
  set verbosity = verbose
  subsection electromagnetics
    set Function expression = cos(4*pi*(x-1)) * sin(4*pi*(y-1)) * exp(-2.624723*(z-1)) * (0.014987*cos(6.767844*(z-1)) + 0.750154*sin(6.767844*(z-1)));    sin(4*pi*(x-1)) * cos(4*pi*(y-1)) * exp(-2.624723*(z-1)) * (-0.014987*cos(6.767844*(z-1)) - 0.750154*sin(6.767844*(z-1)));    0.;    cos(4*pi*(x-1)) * sin(4*pi*(y-1)) * exp(-2.624723*(z-1)) * (-0.750154*cos(6.767844*(z-1)) + 0.014987*sin(6.767844*(z-1)));    sin(4*pi*(x-1)) * cos(4*pi*(y-1)) * exp(-2.624723*(z-1)) * (0.750154*cos(6.767844*(z-1)) - 0.014987*sin(6.767844*(z-1)));    0.;    sin(4*pi*(x-1)) * cos(4*pi*(y-1)) * exp(-2.624723*(z-1)) * (0.104397*cos(6.767844*(z-1)) + 0.269215*sin(6.767844*(z-1)));    cos(4*pi*(x-1)) * sin(4*pi*(y-1)) * exp(-2.624723*(z-1)) * (0.104397*cos(6.767844*(z-1)) + 0.269215*sin(6.767844*(z-1)));    cos(4*pi*(x-1)) * cos(4*pi*(y-1)) * exp(-2.624723*(z-1)) * cos(6.767844*(z-1));    sin(4*pi*(x-1)) * cos(4*pi*(y-1)) * exp(-2.624723*(z-1)) * (-0.269215*cos(6.767844*(z-1)) + 0.104397*sin(6.767844*(z-1)));    cos(4*pi*(x-1)) * sin(4*pi*(y-1)) * exp(-2.624723*(z-1)) * (-0.269215*cos(6.767844*(z-1)) + 0.104397*sin(6.767844*(z-1)));    cos(4*pi*(x-1)) * cos(4*pi*(y-1)) * exp(-2.624723*(z-1)) * sin(6.767844*(z-1))
  end
end

#---------------------------------------------------
# Linear Solver Control
#---------------------------------------------------

subsection linear solver
  subsection electromagnetics
    set verbosity         = quiet
    set preconditioner    = none
    set relative residual = 1e-8
    set minimum residual  = 1e-12
  end
end

#---------------------------------------------------
# Non-Linear Solver Control
#---------------------------------------------------

subsection non-linear solver
  subsection fluid dynamics
    set verbosity = quiet
  end
end
