# Settings file automatically used by clang-tidy
# Heavily adapted from the deal.II clang-tidy file
#
# See ./contrib/utilities/run_clang_tidy.sh for details

#
# Rationale for disabling warnings:
#
# - selected modernize-* warnings:
#   Some of these produce a lot of noise for limited utility.
#
# - performance-inefficient-string-concatenation:
#   We don't care about "a"+to_string(5)+...
#
# - performance-no-automatic-move:
#   All modern compilers perform the return value optimization and we prefer
#   to keep things const.
#
# - performance-enum-size:
#   We don't care if an enum could use a smaller base type than
#   unsigned int.
#
# - modernize-avoid-c-style-cast:
#   Only exists from clang-tidy 22 on. Disabled, as in deal.II, so that runs
#   with a recent clang-tidy agree with the CI (clang-tidy 20).
#
# HeaderFilterRegex:
#   Lethe headers are reached as source/<module>/../../include/<module>/...,
#   so the regex must not assume a normalized path. It skips the bundled
#   include/ankerl/ library.
#

Checks: >
  -*,
  bugprone-integer-division,
  bugprone-throw-keyword-missing,
  cppcoreguidelines-pro-type-static-cast-downcast,
  modernize-*,
  -modernize-avoid-c-arrays,
  -modernize-avoid-c-style-cast,
  -modernize-concat-nested-namespaces,
  -modernize-pass-by-value,
  -modernize-raw-string-literal,
  -modernize-return-braced-init-list,
  -modernize-use-auto,
  -modernize-use-default-member-init,
  -modernize-use-nodiscard,
  -modernize-use-override,
  -modernize-use-trailing-return-type,
  -modernize-use-transparent-functors,
  mpi-*,
  performance-*,
  -performance-enum-size,
  -performance-inefficient-string-concatenation,
  -performance-no-automatic-move,
  -performance-avoid-endl,
  readability-qualified-auto

HeaderFilterRegex: '.*/include/(core|dem|solvers|fem-dem)/.*'
WarningsAsErrors: '*'
