# Three-dimensional baffled stirred tank agitated by a Rushton turbine, solved
# with the mortar element method. The vessel and the impeller are generated by
# Lethe's built-in Rushton mixer grid, which produces the rotating half (inside
# the mortar interface, carrying the shaft, the disc and the six blades) and the
# fixed half (outside it, carrying the four baffles and the tank wall) from the
# same set of dimensions.
#
# The geometry follows the standard Rushton proportions, normalized by the tank
# diameter T = 1: liquid height H = T, impeller diameter D = T/3, disc diameter
# 0.75 D, six blades spanning radially from D/4 to D/2 with a height of D/5,
# off-bottom clearance T/3 and four baffles of width T/10. As on a real Rushton
# turbine the blades start inside the disc rim, so that they protrude above and
# below the disc. The impeller turns at N = 1 revolution per second, and the
# kinematic viscosity is set so that the impeller Reynolds number N D^2 / nu
# is 100.

# Listing of Parameters
#----------------------

set dimension = 3

#---------------------------------------------------
# Simulation Control
#---------------------------------------------------

subsection simulation control
  set method                         = bdf1
  set time step                      = 0.002
  set time end                       = 5
  set output frequency               = 1
  set output path                    = ./output/
  set output name                    = rushton-mixer
  set adapt time step to respect CFL = true
  set max cfl                        = 1
  set output boundaries              = true
end

#---------------------------------------------------
# FEM
#---------------------------------------------------

subsection FEM
  set enable bubble function velocity = true
  set velocity degree                 = 1
  set pressure degree                 = 1
end

#---------------------------------------------------
# Physical Properties
#---------------------------------------------------

subsection physical properties
  set number of fluids = 1
  subsection fluid 0
    # nu = N D^2 / Re with N = 1, D = 1/3 and Re = 100
    set kinematic viscosity = 1. # 1.1111111111111112e-3
  end
end

#---------------------------------------------------
# Forces
#---------------------------------------------------

# The torque on the shaft, the disc and the blades (boundary ids 5, 6 and 7)
# gives the power drawn by the impeller, hence its power number.

subsection forces
  set verbosity        = verbose
  set calculate torque = true
end

#---------------------------------------------------
# Mesh
#---------------------------------------------------

# The mesh subsection describes the stator, i.e. the fixed half of the domain.
# The grid arguments are, in order: tank diameter : liquid height : impeller
# diameter : blade root diameter : disc diameter : disc thickness : blade
# height : shaft diameter : impeller clearance : baffle width : interface
# diameter : number of blades : number of baffles : number of angular cells :
# angular cells per blade : angular cells per baffle : target cell size.

subsection mesh
  set type               = lethe
  set grid type          = rushton_stator
  set grid arguments     = 1 : 1 : 0.3333333333333333 : 0.16666666666666666 : 0.25 : 0.02 : 0.06666666666666667 : 0.1 : 0.3333333333333333 : 0.1 : 0.5 : 6 : 4 : 48 : 1 : 1 : 0
  set initial refinement = 1
end

#---------------------------------------------------
# Mortar
#---------------------------------------------------

# The rotor is generated from exactly the same grid arguments as the stator,
# which is what guarantees that the two sides of the interface carry the same
# number of faces and discretize the height identically.

subsection mortar
  set enable = true
  subsection mesh
    set type           = lethe
    set grid type      = rushton_rotor
    set grid arguments = 1 : 1 : 0.3333333333333333 : 0.16666666666666666 : 0.25 : 0.02 : 0.06666666666666667 : 0.1 : 0.3333333333333333 : 0.1 : 0.5 : 6 : 4 : 48 : 1 : 1 : 0
  end
  set rotor boundary id       = 10
  set stator boundary id      = 0
  set center of rotation      = 0, 0, 0
  set rotation axis direction = 2
  subsection rotor rotation angle
    set Function constants  = omega=6.283185307179586
    set Function expression = omega*t
  end
  subsection rotor angular velocity
    set Function constants  = omega=6.283185307179586
    set Function expression = omega
  end
  set penalty factor = 1
  set verbosity      = verbose
end

#---------------------------------------------------
# Boundary Conditions
#---------------------------------------------------

# The stator carries five boundary ids, so the rotor ids are shifted by five
# when the two halves are merged:
#   0 stator side of the mortar interface   5 shaft
#   1 tank wall                             6 disc
#   2 baffles                               7 blades
#   3 stator floor                          8 rotor floor
#   4 stator free surface                   9 rotor free surface
#                                          10 rotor side of the mortar interface
# The rotor mesh rotates rigidly, but its floor and its free surface are annuli
# centered on the axis, so they are invariant under that rotation and the no-slip
# and slip conditions below remain those of a fixed vessel.

subsection boundary conditions
  set number = 6
  set fix pressure constant = true
  subsection bc 0
    set type = none
    set id   = 0, 10
  end
  subsection bc 1
    set type = noslip
    set id   = 1, 2, 3
  end
  subsection bc 2
    set type = slip
    set id   = 4
  end
  subsection bc 3
    set type = function
    set id   = 5, 6, 7
    subsection u
      set Function constants  = omega=6.283185307179586
      set Function expression = -omega*y
    end
    subsection v
      set Function constants  = omega=6.283185307179586
      set Function expression = omega*x
    end
    subsection w
      set Function expression = 0
    end
  end
  subsection bc 4
    set type = noslip
    set id   = 8
  end
  subsection bc 5
    set type = slip
    set id   = 9
  end
end

#---------------------------------------------------
# Non-Linear Solver Control
#---------------------------------------------------

subsection non-linear solver
  subsection fluid dynamics
    set verbosity      = verbose
    set tolerance      = 1e-5
    set max iterations = 10
  end
end

#---------------------------------------------------
# Timer
#---------------------------------------------------

subsection timer
  set type = iteration
end

#---------------------------------------------------
# Linear Solver Control
#---------------------------------------------------

subsection linear solver
  subsection fluid dynamics
    set verbosity          = extra verbose
    set method             = gmres
    set relative residual  = 1e-4
    set minimum residual   = 1e-6
    set preconditioner     = amg
    set max krylov vectors = 400
  end
end
