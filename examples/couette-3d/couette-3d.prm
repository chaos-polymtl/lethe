#-----------------------------------------------------------------------
# EX2 - 3D Couette flow with particles
#-----------------------------------------------------------------------
set dimension = 3
subsection simulation control
  set method            = steady
  set number mesh adapt = 0
  set output name       = couette-EX2-particles-3d
  set output frequency  = 1
  set subdivision       = 1
  set output path       = ./out/
end
subsection physical properties
  subsection fluid 0
    set kinematic viscosity = 10
    set density             = 1
  end
end
subsection timer
  set type = iteration
end
subsection FEM
  set velocity degree = 1
  set pressure degree = 1
end
subsection mesh
  set type               = dealii
  set grid type          = subdivided_hyper_rectangle
  set grid arguments     = 25,10,10 : 0,0,0 : 75,30,20 : true
  set initial refinement = 2
end
subsection boundary conditions
  set number = 4
  subsection bc 0
    set id                 = 0
    set type               = periodic
    set periodic id        = 1
    set periodic direction = 0
  end
  subsection bc 1
    set id   = 2
    set type = function
    subsection u
      set Function expression = 0
    end
    subsection v
      set Function expression = 0
    end
    subsection w
      set Function expression = 0
    end
  end
  subsection bc 2
    set id   = 3
    set type = function
    subsection u
      set Function expression = 1.5
    end
    subsection v
      set Function expression = 0
    end
    subsection w
      set Function expression = 0
    end
  end
  subsection bc 3
    set id                 = 4
    set type               = periodic
    set periodic id        = 5
    set periodic direction = 2
  end
end
subsection initial conditions
  set type = nodal
  subsection uvwp
    set Function expression = y/20; 0; 0; 0
  end
end
subsection particles
  set assemble Navier-Stokes inside particles = true
  set number of particles = 10
  subsection extrapolation function
    set length ratio   = 2
    set stencil degree = 2
  end
  subsection local mesh refinement
    set initial refinement                = 2
    set refine mesh inside radius factor  = 0.7
    set refine mesh outside radius factor = 1.2
  end
  subsection particle info 0
    set type = sphere
    set shape arguments = 1
    set integrate motion = false
    subsection position
      set Function expression = 7;5;10
    end
    subsection velocity
      set Function expression = 0.25;0;0
    end
  end
  subsection particle info 1
    set type = sphere
    set shape arguments = 1
    set integrate motion = false
    subsection position
      set Function expression = 18;14;10
    end
    subsection velocity
      set Function expression = 0.7;0;0
    end
  end
  subsection particle info 2
    set type = sphere
    set shape arguments = 1
    set integrate motion = false
    subsection position
      set Function expression = 28;7;10
    end
    subsection velocity
      set Function expression = 0.35;0;0
    end
  end
  subsection particle info 3
    set type = sphere
    set shape arguments = 1
    set integrate motion = false
    subsection position
      set Function expression = 38;12;10
    end
    subsection velocity
      set Function expression = 0.6;0;0
    end
  end
  subsection particle info 4
    set type = sphere
    set shape arguments = 1
    set integrate motion = false
    subsection position
      set Function expression = 12;16;10
    end
    subsection velocity
      set Function expression = 0.8;0;0
    end
  end
  subsection particle info 5
    set type = sphere
    set shape arguments = 1
    set integrate motion = false
    subsection position
      set Function expression = 33;4;10
    end
    subsection velocity
      set Function expression = 0.2;0;0
    end
  end
  subsection particle info 6
    set type = sphere
    set shape arguments = 1
    set integrate motion = false
    subsection position
      set Function expression = 68;24;10
    end
    subsection velocity
      set Function expression = 1.2;0;0
    end
  end
  subsection particle info 7
    set type = sphere
    set shape arguments = 1
    set integrate motion = false
    subsection position
      set Function expression = 44;9;10
    end
    subsection velocity
      set Function expression = 0.45;0;0
    end
  end
  subsection particle info 8
    set type = sphere
    set shape arguments = 1
    set integrate motion = false
    subsection position
      set Function expression = 48;11;10
    end
    subsection velocity
      set Function expression = 0.55;0;0
    end
  end
  subsection particle info 9
    set type = sphere
    set shape arguments = 1
    set integrate motion = false
    subsection position
      set Function expression = 66;17;10
    end
    subsection velocity
      set Function expression = 1.15;0;0
    end
  end
end
subsection mesh adaptation
  set type = none
end
subsection forces
  set verbosity             = verbose
  set calculate force       = true
  set calculate torque      = false
  set force name            = force_10p_3d
  set calculation frequency = 1
  set output frequency      = 1
end
subsection non-linear solver
  subsection fluid dynamics
    set tolerance      = 1e-4
    set max iterations = 10
    set verbosity      = verbose
  end
end
subsection linear solver
  subsection fluid dynamics
    set method                                = gmres
    set max iters                             = 5000
    set max krylov vectors                    = 1000
    set relative residual                     = 1e-2
    set minimum residual                      = 1e-8
    set preconditioner                        = ilu
    set ilu preconditioner fill               = 2
    set ilu preconditioner relative tolerance = 1.00
    set verbosity                             = verbose
  end
end
