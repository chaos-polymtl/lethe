# Listing of Parameters
#----------------------

# This case is the CFD-DEM counterpart of
# examples/dem-mp/3d-heat-transfer-in-aligned-particles/equilibrium.prm. Ten
# aligned particles, the five on the left at -30 C and the five on the right at
# +30 C, are pressed against one another and exchange heat by conduction until
# they all reach 0 C.
#
# It is run with lethe-fluid-particles rather than lethe-particles. The fluid
# dynamics is disabled and every fluid-particle interaction force is turned off,
# so the particles obey exactly the same equations as in the pure DEM case. The
# purpose of the case is to verify that the multiphysic DEM gives the same
# result within the CFD-DEM solver.
#
# Two differences with the DEM case are needed because the CFD-DEM solver does
# not support solid objects:
#  - the two plates which compress the particles are replaced by two floating
#    walls placed at the position where these plates come to rest (x = +-0.049);
#  - the particles are inserted as a chain which already fills the gap between
#    these walls, instead of being spaced by 0.02 m and compressed during the
#    first 6.1 s. The conduction therefore starts at t = 0.

set dimension = 3

#---------------------------------------------------
# Simulation Control
#---------------------------------------------------

# The DEM time step is the CFD time step divided by the coupling frequency,
# which gives back the 5e-5 s of the DEM case.
subsection simulation control
  set method           = bdf1
  set output name      = out
  set time step        = 5e-3
  set time end         = 20
  set log frequency    = 100
  set output frequency = 100
  set output path      = ./output_equilibrium/
end

#---------------------------------------------------
# Multiphysics
#---------------------------------------------------

# The fluid dynamics is not solved. The velocity and the pressure are kept at
# the values given by the initial condition.
subsection multiphysics
  set fluid dynamics = false
end

#---------------------------------------------------
# Initial Conditions
#---------------------------------------------------

subsection initial conditions
  set type = nodal
  subsection uvwp
    set Function expression = 0; 0; 0; 0
  end
end

#---------------------------------------------------
# FEM
#---------------------------------------------------

subsection FEM
  set velocity degree = 1
  set pressure degree = 1
end

#---------------------------------------------------
# Physical Properties
#---------------------------------------------------

# The fluid is never solved and never acts on the particles. These values are
# only there because the solver requires a fluid to be defined.
subsection physical properties
  subsection fluid 0
    set kinematic viscosity = 1.5e-5
    set density             = 1.2
  end
end

#---------------------------------------------------
# Mesh
#---------------------------------------------------

subsection mesh
  set type               = dealii
  set grid type          = hyper_rectangle
  set grid arguments     = -0.15 , -0.025 , -0.025 : 0.15 , 0.025 , 0.025 : false
  set initial refinement = 1
end

#---------------------------------------------------
# Void Fraction
#---------------------------------------------------

# The void fraction is prescribed to one. Since no fluid-particle interaction
# force is enabled, it has no effect on the particles and there is no reason to
# pay for its calculation with the QCM.
subsection void fraction
  set mode = function
  subsection function
    set Function expression = 1
  end
end

#---------------------------------------------------
# CFD-DEM
#---------------------------------------------------

# Every fluid-particle interaction force is disabled so that the particles
# behave exactly as they do in the pure DEM case.
subsection cfd-dem
  set drag force         = false
  set buoyancy force     = false
  set shear force        = false
  set pressure force     = false
  set coupling frequency = 100
end

#---------------------------------------------------
# Boundary Conditions
#---------------------------------------------------

subsection boundary conditions
  set number = 1
  subsection bc 0
    set id   = 0
    set type = slip
  end
end

#---------------------------------------------------
# Model parameters
#---------------------------------------------------

subsection model parameters
  subsection contact detection
    set contact detection method                = dynamic
    set dynamic contact search size coefficient = 0.9
    set neighborhood threshold                  = 1.3
  end
  set particle particle contact force method = hertz_mindlin_limit_overlap
  set rolling resistance torque method       = constant
  set particle wall contact force method     = nonlinear
  set integration method                     = velocity_verlet
  set solver type                            = dem_mp
end

#---------------------------------------------------
# Lagrangian Physical Properties
#---------------------------------------------------

subsection lagrangian physical properties
  set g                        = 0.0, 0.0, 0.0
  set number of particle types = 1
  subsection particle type 0
    set size distribution type            = uniform
    set diameter                          = 0.01
    set number of particles               = 10
    set density particles                 = 2500
    set young modulus particles           = 1e6
    set poisson ratio particles           = 0.3
    set restitution coefficient particles = 0.3
    set friction coefficient particles    = 0.3
    set rolling friction particles        = 0.3
    set thermal conductivity particles    = 3000
    set specific heat particles           = 300
    set microhardness particles           = 1.e9
    set surface slope particles           = 0.1
    set surface roughness particles       = 1.e-9
    set thermal accommodation particles   = 0.7
  end
  set young modulus wall           = 1e6
  set poisson ratio wall           = 0.3
  set restitution coefficient wall = 0.3
  set friction coefficient wall    = 0.3
  set rolling friction wall        = 0.3
  set thermal conductivity gas     = 0.2
  set specific heat gas            = 10000
  set dynamic viscosity gas        = 9.e-6
  set specific heats ratio gas     = 1.4
  set molecular mean free path gas = 68.e-9
end

#---------------------------------------------------
# Insertion Info
#---------------------------------------------------

subsection insertion info
  set insertion method    = file
  set insertion frequency = 10000
  set list of input files = particles-equilibrium.input
end

#---------------------------------------------------
# Floating Walls
#---------------------------------------------------

# These two walls replace the moving solid objects of the DEM case. They are
# placed where the plates come to rest and hold the chain of particles in
# compression. Floating walls are adiabatic, like the plates they replace.
subsection floating walls
  set number of floating walls = 2
  subsection wall 0
    set point on wall = -0.049, 0., 0.
    set normal vector = 1., 0., 0.
    set start time    = 0
    set end time      = 20
  end
  subsection wall 1
    set point on wall = 0.049, 0., 0.
    set normal vector = -1., 0., 0.
    set start time    = 0
    set end time      = 20
  end
end

#---------------------------------------------------
# Lagrangian Post-processing
#---------------------------------------------------

subsection post-processing
  set lagrangian post-processing = true
end

#---------------------------------------------------
# Linear Solver Control
#---------------------------------------------------

subsection linear solver
  subsection void fraction
    set relative residual = 1e-15
    set minimum residual  = 1e-15
  end
end
