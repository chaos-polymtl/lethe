# =============================================================================
# Couette Flow With Twenty Fixed Spheres (3D Sharp Immersed Boundary)
# =============================================================================
# Steady Couette flow between two parallel plates (y = 0 and y = 30) with
# streamwise (x) and spanwise (z) periodicity. Twenty rigid spheres of radius
# R = 1 sit in the midplane z = 10 with random (x, y) centers. Particle
# velocities follow the Couette profile u = y/20 so that each sphere is in
# equilibrium with the undisturbed shear.
#
# Domain: 75 x 30 x 20. Fluid: nu = 10, rho = 1. Walls use weak Dirichlet
# (beta = 10). Navier-Stokes is not assembled inside particles. Wall forces
# compared to the Einstein dilute limit mu (1 + 5/2 phi) with F0 = 750 for the empty channel.
# =============================================================================

set dimension = 3

set dimension = 3

subsection simulation control
  set method            = steady
  set number mesh adapt = 0
  set output name       = couette-3d-20p
  set output frequency  = 1
  set subdivision       = 1
  set output path       = ./out_20p/
end

subsection physical properties
  subsection fluid 0
    set kinematic viscosity = 10
    set density             = 1
  end
end

subsection timer
  set type = iteration
end

subsection FEM
  set velocity degree = 1
  set pressure degree = 1
end

subsection mesh
  set type               = dealii
  set grid type          = subdivided_hyper_rectangle
  set grid arguments     = 25,10,10 : 0,0,0 : 75,30,20 : true
  set initial refinement = 2
end

subsection boundary conditions
  set number = 4
  subsection bc 0
    set id                 = 0
    set type               = periodic
    set periodic id        = 1
    set periodic direction = 0
  end
  subsection bc 1
    set id   = 2
    set type = function_weak
    subsection u
      set Function expression = 0
    end
    subsection v
      set Function expression = 0
    end
    subsection w
      set Function expression = 0
    end
    set beta = 10
  end
  subsection bc 2
    set id   = 3
    set type = function_weak
    subsection u
      set Function expression = 1.5
    end
    subsection v
      set Function expression = 0
    end
    subsection w
      set Function expression = 0
    end
    set beta = 10
  end
  subsection bc 3
    set id                 = 4
    set type               = periodic
    set periodic id        = 5
    set periodic direction = 2
  end
end

subsection initial conditions
  set type = nodal
  subsection uvwp
    set Function expression = y/20; 0; 0; 0
  end
end

subsection particles
  set assemble Navier-Stokes inside particles = false
  set number of particles                     = 20
  subsection extrapolation function
    set length ratio   = 2
    set stencil degree = 2
  end
  subsection local mesh refinement
    set initial refinement                = 2
    set refine mesh inside radius factor  = 0.7
    set refine mesh outside radius factor = 1.2
  end
  subsection particle info 0
    set type             = sphere
    set shape arguments  = 1
    set integrate motion = false
    subsection position
      set Function expression = 25.520628; 6.969531; 10.000000
    end
    subsection velocity
      set Function expression = 0.348477; 0; 0
    end
  end
  subsection particle info 1
    set type             = sphere
    set shape arguments  = 1
    set integrate motion = false
    subsection position
      set Function expression = 47.763544; 5.166035; 10.000000
    end
    subsection velocity
      set Function expression = 0.258302; 0; 0
    end
  end
  subsection particle info 2
    set type             = sphere
    set shape arguments  = 1
    set integrate motion = false
    subsection position
      set Function expression = 39.939976; 11.910845; 10.000000
    end
    subsection velocity
      set Function expression = 0.595542; 0; 0
    end
  end
