# Contact between two sedimenting spheres (drafting, kissing and tumbling),
# section 4.3 of Barbeau et al., Computers & Fluids 268 (2024) 106094.
# Discretization: Q1Q1, h = 1/128 cm
# Units: g, cm, s (pressure and Young's modulus in dyn/cm^2 = 0.1 Pa)

# Listing of Parameters
#----------------------

set dimension = 3

#---------------------------------------------------
# Simulation Control
#---------------------------------------------------

subsection simulation control
  set method                         = bdf2
  set bdf startup method             = multiple_step_bdf
  set time step                      = 0.001
  set adapt time step to respect CFL = true
  set max cfl                        = 0.8
  set time end                       = 0.7
  set output name                    = out
  set output path                    = out-q1q1-h128/
  set output frequency               = 50
  set log precision                  = 8
end

#---------------------------------------------------
# Physical Properties
#---------------------------------------------------

subsection physical properties
  subsection fluid 0
    set kinematic viscosity = 0.01
    set density             = 1
  end
end

#---------------------------------------------------
# Timer
#---------------------------------------------------

subsection timer
  set type = iteration
end

#---------------------------------------------------
# FEM
#---------------------------------------------------

subsection FEM
  set velocity degree = 1
  set pressure degree = 1
end

#---------------------------------------------------
# Mesh
#---------------------------------------------------

subsection mesh
  set type               = dealii
  set grid type          = subdivided_hyper_rectangle
  set grid arguments     = 1,1,4 : 0,0,0 : 1,1,4 : true
  set initial refinement = 4
end

#---------------------------------------------------
# Boundary Conditions
#---------------------------------------------------

subsection boundary conditions
  set number = 6
  subsection bc 0
    set id   = 0
    set type = noslip
  end
  subsection bc 1
    set id   = 1
    set type = noslip
  end
  subsection bc 2
    set id   = 2
    set type = noslip
  end
  subsection bc 3
    set id   = 3
    set type = noslip
  end
  subsection bc 4
    set id   = 4
    set type = noslip
  end
  # Top of the tank: weak no-slip, so that the problem is well-posed
  subsection bc 5
    set id   = 5
    set type = function_weak
    set beta = 1
    subsection u
      set Function expression = 0
    end
    subsection v
      set Function expression = 0
    end
    subsection w
      set Function expression = 0
    end
  end
end

#---------------------------------------------------
# IB particles
#---------------------------------------------------

subsection particles
  set assemble Navier-Stokes inside particles = false
  set number of particles                     = 2

  subsection extrapolation function
    set length ratio   = 2
    set stencil degree = 1
  end

  subsection local mesh refinement
    set initial refinement                = 3
    set refine mesh inside radius factor  = 0.5
    set refine mesh outside radius factor = 1.5
  end

  subsection DEM
    set DEM coupling frequency       = 10000
    set particle nonlinear tolerance = 1e-5
    set enable lubrication force     = true
    set lubrication range max        = 2
    set lubrication range min        = 0.1
    subsection gravity
      set Function expression = 0;0;-980
    end
    subsection wall physical properties
      set wall friction coefficient         = 0
      set wall poisson ratio                = 0.3
      set wall restitution coefficient      = 1
      set wall rolling friction coefficient = 0
      set wall youngs modulus               = 1e12
    end
  end

  # p0: upper sphere
  subsection particle info 0
    set type             = sphere
    set shape arguments  = 0.083333333333333333
    set integrate motion = true
    subsection position
      set Function expression = 0.503333333333333333;0.5;3.5
    end
    subsection velocity
      set Function expression = 0;0;0
    end
    subsection physical properties
      set density                      = 1.14
      set friction coefficient         = 0
      set poisson ratio                = 0.3
      set restitution coefficient      = 1
      set rolling friction coefficient = 0
      set youngs modulus               = 1e12
    end
  end

  # p1: lower sphere
  subsection particle info 1
    set type             = sphere
    set shape arguments  = 0.083333333333333333
    set integrate motion = true
    subsection position
      set Function expression = 0.5;0.5;3.16
    end
    subsection velocity
      set Function expression = 0;0;0
    end
    subsection physical properties
      set density                      = 1.14
      set friction coefficient         = 0
      set poisson ratio                = 0.3
      set restitution coefficient      = 1
      set rolling friction coefficient = 0
      set youngs modulus               = 1e12
    end
  end
end

#---------------------------------------------------
# Mesh Adaptation Control
#---------------------------------------------------

subsection mesh adaptation
  set type                 = adaptive
  set error estimator      = kelly
  set variable             = velocity
  set fraction type        = number
  set fraction coarsening  = 0.3
  set fraction refinement  = 0.05
  set frequency            = 1
  set max number elements  = 750000
  set max refinement level = 7
  set min refinement level = 4
end

#---------------------------------------------------
# Initial condition
#---------------------------------------------------

subsection initial conditions
  set type = nodal
  subsection uvwp
    set Function expression = 0;0;0;0
  end
end

#---------------------------------------------------
# Non-Linear Solver Control
#---------------------------------------------------

subsection non-linear solver
  subsection fluid dynamics
    set verbosity             = verbose
    set tolerance             = 1e-7
    set max iterations        = 10
    set force rhs calculation = true
  end
end

#---------------------------------------------------
# Linear Solver Control
#---------------------------------------------------

subsection linear solver
  subsection fluid dynamics
    set method                                = gmres
    set max iters                             = 1000
    set relative residual                     = 1e-5
    set minimum residual                      = 1e-9
    set preconditioner                        = ilu
    set ilu preconditioner fill               = 0
    set ilu preconditioner absolute tolerance = 1e-12
    set ilu preconditioner relative tolerance = 1.00
    set verbosity                             = verbose
    set max krylov vectors                    = 200
  end
end
