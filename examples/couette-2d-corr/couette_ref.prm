set dimension = 2

subsection simulation control
  set method             = steady
  set number mesh adapt  = 0
  set output name        = couette_ref_no_particles
  set output frequency   = 1
  set subdivision        = 1
  set output path        = out_ref/
end

subsection physical properties
  subsection fluid 0
    set kinematic viscosity = 10
    set density             = 1
  end
end

subsection timer
  set type = iteration
end

subsection FEM
  set velocity degree = 1
  set pressure degree = 1
end

subsection mesh
  set type               = dealii
  set grid type          = subdivided_hyper_rectangle
  set grid arguments     = 25,10 : 0,0 : 50,20 : true
  set initial refinement = 2
end

subsection boundary conditions
  set number = 3

  subsection bc 0
    set id                 = 0
    set type               = periodic
    set periodic id        = 1
    set periodic direction = 0
  end

  subsection bc 1
    set id   = 2
    set type = function
    subsection u
      set Function expression = 0
    end
    subsection v
      set Function expression = 0
    end
  end

  subsection bc 2
    set id   = 3
    set type = function
    subsection u
      set Function expression = 1
    end
    subsection v
      set Function expression = 0
    end
  end
end

subsection initial conditions
  set type = nodal
  subsection uvwp
    set Function expression = y/20; 0; 0
  end
end

subsection non-linear solver
  subsection fluid dynamics
    set verbosity             = verbose
    set tolerance             = 1e-6
    set max iterations        = 10
    set force rhs calculation = true
  end
end

subsection forces
  set verbosity             = verbose
  set calculate force       = true
  set force name            = force_ref
  set output precision      = 10
  set calculation frequency = 1
  set output frequency      = 1
end

subsection linear solver
  subsection fluid dynamics
    set method                                = gmres
    set max iters                             = 1000
    set max krylov vectors                    = 1000
    set relative residual                     = 1e-2
    set minimum residual                      = 1e-8
    set preconditioner                        = ilu
    set ilu preconditioner fill               = 1
    set ilu preconditioner absolute tolerance = 1e-10
    set ilu preconditioner relative tolerance = 1.00
    set verbosity                             = verbose
  end
end
